# Dominio canónico del sitio (sin barra final). Se usa en canonical, sitemap,
# robots y datos estructurados. Cámbialo al mover la landing de dominio.
SITE_URL=https://umbrallab.es

# App a la que se redirige cuando el visitante ya tiene sesión. La cookie
# `umbral_session` la pone la app en `.umbrallab.es` al iniciar sesión.
APP_URL=https://app.umbrallab.es

# Buzón real que recibe los avisos del formulario. NO es Resend: Resend envía,
# no recibe. Puede ser un buzón de Hostinger o un alias de Cloudflare Email
# Routing que reenvíe a tu correo personal.
WAITLIST_TO=solicitudes@umbrallab.es

# Remitente verificado en Resend. En producción debe ser del dominio verificado
# (por ejemplo, no-reply@umbrallab.es). onboarding@resend.dev solo sirve para
# pruebas y solo entrega al correo de la cuenta de Resend.
WAITLIST_FROM="Umbral <no-reply@umbrallab.es>"

# Resend (solo servidor; no expongas esta clave en el navegador)
RESEND_API_KEY=

# URL del endpoint que usa el formulario. Déjalo en /api/waitlist si la API
# vive en el mismo dominio que la landing.
PUBLIC_WAITLIST_ENDPOINT=/api/waitlist

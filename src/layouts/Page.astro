---
import Layout from './Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  breadcrumb?: { name: string; url?: string }[];
  extra?: Record<string, unknown> | Record<string, unknown>[];
  kicker?: string;
  h1: string;
  lead: string;
  /** Las páginas legales no llevan llamada a la acción de producto. */
  actions?: boolean;
}

const {
  title,
  description,
  breadcrumb,
  extra,
  kicker,
  h1,
  lead,
  actions = true,
} = Astro.props;
---

<Layout title={title} description={description} breadcrumb={breadcrumb} extra={extra} animated={false}>
  <div class="p-page">
    <PageHeader />

    <main id="contenido" tabindex="-1">
      <section class="p-hero">
        <div class="u-wrap p-hero__inner">
          {kicker && <p class="u-kicker">{kicker}</p>}
          <h1 class="p-hero__title">{h1}</h1>
          <p class="p-hero__lead">{lead}</p>
          {actions && (
            <div class="p-hero__actions">
              <a class="u-btn" href="/#acceso">
                <span class="u-dot" aria-hidden="true"></span>
                Pedir acceso para mi club
              </a>
              <a class="u-btn u-btn--ghost" href="/">Ver la home de Umbral</a>
            </div>
          )}
        </div>
      </section>

      <div class="p-body u-wrap">
        <slot />
      </div>
    </main>

    <Footer home="/" />
  </div>
</Layout>

<style is:global>
  /* ==========================================================================
     Páginas de contenido: triatlón, atletismo, entrenamiento y guías.
     Reutilizan los tokens de landing.css; aquí solo vive la maquetación propia
     de las subpáginas, sin animación.
     ========================================================================== */

  .p-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--ivory);
  }

  .p-page > main {
    flex: 1;
  }

  /* Hero de página */
  .p-hero {
    padding-block: clamp(48px, 6vw, 88px) clamp(36px, 4vw, 64px);
    border-bottom: 1px solid var(--line);
  }

  .p-hero__inner {
    max-width: 880px;
  }

  .p-hero__title {
    margin-top: 20px;
    font-family: var(--display);
    font-size: clamp(2.3rem, 4.6vw, 4.4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .p-hero__lead {
    max-width: 62ch;
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    line-height: 1.65;
  }

  .p-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  .p-hero__actions .u-btn {
    min-height: 50px;
  }

  /* Cuerpo de artículo */
  .p-body {
    max-width: 880px;
    padding-block: clamp(40px, 5vw, 72px) clamp(56px, 6vw, 96px);
  }

  .p-body > * + * {
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  .p-body h2 {
    font-family: var(--display);
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .p-body h3 {
    font-family: var(--display);
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .p-body p {
    color: var(--ink-soft);
    font-size: clamp(0.98rem, 1.05vw, 1.08rem);
    line-height: 1.72;
  }

  .p-body strong {
    color: var(--ink);
    font-weight: 600;
  }

  .p-body ul,
  .p-body ol {
    display: grid;
    gap: 10px;
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1vw, 1.05rem);
    line-height: 1.65;
  }

  /* El número y el punto van en position:absolute y el contenido fluye como
     texto normal. Si se usara grid o flex aquí, un <strong> inicial y el
     texto que le sigue se convertirían en items separados y el texto caería
     en la columna del número (una palabra por línea). */
  .p-body ul li {
    position: relative;
    padding-left: 17px;
  }

  .p-body ul li::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
  }

  .p-body ol {
    counter-reset: p-step;
  }

  .p-body ol li {
    counter-increment: p-step;
    position: relative;
    padding-left: 46px;
  }

  .p-body ol li::before {
    content: counter(p-step, decimal-leading-zero);
    position: absolute;
    top: 2px;
    left: 0;
    width: 32px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 30px;
    text-align: center;
  }

  .p-body a:not(.u-btn) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .p-body code {
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
    background: var(--card);
    font-family: var(--mono);
    font-size: 0.86em;
    white-space: nowrap;
  }

  /* Páginas legales: mismo cuerpo, pero con lectura más compacta y sin
     llamadas a la acción de producto. */
  .p-legal {
    max-width: 760px;
  }

  .p-legal > * + * {
    margin-top: 18px;
  }

  .p-legal h2 {
    margin-top: 40px;
    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
  }

  .p-legal h2:first-child {
    margin-top: 0;
  }

  .p-legal h3 {
    margin-top: 24px;
    font-size: clamp(1.02rem, 1.2vw, 1.15rem);
  }

  .p-legal p,
  .p-legal li {
    font-size: 14.5px;
    line-height: 1.72;
  }

  .p-legal ul {
    gap: 8px;
  }

  .p-legal__meta {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .p-legal__data {
    display: grid;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--u-radius-sm);
    background: var(--card);
    font-size: 14px;
    line-height: 1.6;
  }

  .p-legal__data strong {
    color: var(--ink);
  }

  /* Bloques de tarjetas */
  .p-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .p-card {
    padding: clamp(20px, 2vw, 26px);
    border: 1px solid var(--line);
    border-radius: var(--u-radius-sm);
    background: var(--card);
  }

  .p-card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .p-card p {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.62;
  }

  .p-card .p-card__tag {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Tablas */
  .p-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--u-radius-sm);
    background: var(--card);
  }

  .p-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    line-height: 1.55;
  }

  .p-body th {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .p-body td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--ink-soft);
    vertical-align: top;
  }

  .p-body tr:last-child td {
    border-bottom: none;
  }

  .p-body td:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  /* Banda oscura intercalada */
  .p-band {
    padding: clamp(28px, 3.4vw, 44px) clamp(22px, 2.6vw, 40px);
    border-radius: var(--u-radius-sm);
    color: var(--ivory);
    background: var(--ink);
  }

  .p-band h2 {
    color: var(--ivory);
  }

  .p-band p {
    color: #cbc8bf;
  }

  .p-band .p-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .p-band .u-btn {
    border-color: var(--signal);
    color: var(--ink);
    background: var(--signal);
  }

  .p-band .u-btn:hover {
    border-color: #38ea6c;
    background: #38ea6c;
  }

  .p-band .u-btn--ghost {
    border-color: rgba(240, 237, 229, 0.22);
    color: var(--ivory);
    background: transparent;
  }

  .p-band .u-btn--ghost:hover {
    border-color: rgba(240, 237, 229, 0.5);
    background: transparent;
  }

  /* Relacionados */
  .p-related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .p-related a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--u-radius-sm);
    background: var(--card);
    transition:
      transform 300ms var(--ease),
      border-color 260ms var(--ease);
  }

  .p-related a:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--signal) 70%, var(--line));
  }

  .p-related .p-related__kicker {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .p-related .p-related__title {
    color: var(--ink);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .p-related .p-related__desc {
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.5;
  }

  /* FAQ de página */
  .p-faq {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .p-faq details {
    border-bottom: 1px solid var(--line);
  }

  .p-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .p-faq summary::-webkit-details-marker {
    display: none;
  }

  .p-faq summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: 8px;
  }

  .p-faq .p-faq__toggle {
    position: relative;
    width: 28px;
    height: 28px;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background-color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .p-faq .p-faq__toggle::before,
  .p-faq .p-faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1px;
    background: var(--ink);
    transform: translate(-50%, -50%);
  }

  .p-faq .p-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .p-faq details[open] .p-faq__toggle {
    border-color: var(--ink);
    background: var(--ink);
  }

  .p-faq details[open] .p-faq__toggle::before,
  .p-faq details[open] .p-faq__toggle::after {
    background: var(--ivory);
  }

  .p-faq details[open] .p-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .p-faq .p-faq__a {
    max-width: 68ch;
    padding: 0 48px 20px 0;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.7;
  }

  .p-faq .p-faq__a code {
    padding: 2px 5px;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--ink);
    background: var(--card);
    font-family: var(--mono);
    font-size: 0.86em;
  }

  .p-faq .p-faq__a a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .p-cards,
    .p-related {
      grid-template-columns: 1fr;
    }

    .p-body ol li {
      padding-left: 40px;
    }

    .p-body ol li::before {
      width: 28px;
      height: 26px;
      line-height: 26px;
      font-size: 9px;
    }
  }
</style>

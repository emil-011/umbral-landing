---
const principles = [
  { num: '01', title: 'Ayuda, no obliga', text: 'El plan se escribe como siempre. Sifos se adapta al método, no al revés.' },
  { num: '02', title: 'Tolerante con tu forma', text: 'Abreviaturas, distancias, repeticiones, comas y comillas: todo vale.' },
  { num: '03', title: 'No inventa', text: 'Si falta un dato, lo dice. Preferimos una carga parcial a un número falso.' },
];
---

<section class="manifesto" aria-labelledby="manifesto-title">
  <div class="container manifesto__inner">
    <div class="manifesto__quote reveal">
      <p class="eyebrow" id="manifesto-title">La idea detrás</p>
      <blockquote>
        «El entrenamiento no mejora por medirlo todo. Mejora cuando lo que mides{' '}
        <span>significa algo</span>.»
      </blockquote>
      <p class="manifesto__sign">Sifos · menos ruido, más criterio.</p>
    </div>

    <ul class="manifesto__principles reveal">
      {principles.map((principle) => (
        <li>
          <span class="manifesto__num">{principle.num}</span>
          <div>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    padding-block: clamp(58px, 7vw, 92px);
    border-block: 1px solid var(--hairline-soft);
    background: rgba(255, 255, 255, 0.22);
  }

  .manifesto__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    align-items: start;
    gap: clamp(38px, 6vw, 90px);
  }

  .manifesto blockquote {
    max-width: 21ch;
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: clamp(1.95rem, 4vw, 3.65rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: pretty;
  }

  .manifesto blockquote span {
    color: var(--accent-deep);
    font-weight: 600;
  }

  .manifesto__sign {
    margin-top: 24px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .manifesto__principles {
    display: grid;
    gap: 22px;
    padding-top: 8px;
  }

  .manifesto__principles li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline-soft);
  }

  .manifesto__num {
    color: var(--accent-deep);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .manifesto__principles h3 {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .manifesto__principles p {
    max-width: 34ch;
    margin-top: 4px;
    color: var(--ink-soft);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  @media (max-width: 880px) {
    .manifesto__inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .manifesto blockquote {
      max-width: 24ch;
    }

    .manifesto__principles {
      gap: 16px;
      padding-top: 0;
    }
  }
</style>

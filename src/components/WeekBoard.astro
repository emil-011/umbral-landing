---
const week = [
  {
    dow: 'LUN',
    day: '9',
    sport: 'swim',
    label: 'Natación',
    title: 'Técnica + 8 × 100 m',
    hint: 'Z2 · 2.400 m',
    zone: 'Z2',
    eco: '26',
  },
  {
    dow: 'MAR',
    day: '10',
    sport: 'bike',
    label: 'Bici',
    title: '3 h 15′ ALMED',
    hint: 'Z2 · 92 km',
    zone: 'Z2',
    eco: '96',
  },
  {
    dow: 'MIÉ',
    day: '11',
    sport: 'strength',
    label: 'Fuerza',
    title: 'Core + movilidad',
    hint: '35 min',
    zone: '—',
    eco: '14',
  },
  {
    dow: 'JUE',
    day: '12',
    sport: 'run',
    label: 'Carrera',
    title: '8 × 400 m UA / 1′ ALL',
    hint: 'Z4 · 10,4 km',
    zone: 'Z4',
    eco: '58',
    today: true,
  },
  {
    dow: 'VIE',
    day: '13',
    sport: 'rest',
    label: 'Descanso',
    title: 'Sueño y activación',
    hint: '20 min',
    zone: 'Z1',
    eco: '12',
  },
  {
    dow: 'SÁB',
    day: '14',
    sport: 'run',
    label: 'Carrera',
    title: 'Tirada 90′ ALMED',
    hint: 'Z2 · 17,8 km',
    zone: 'Z2',
    eco: '80',
  },
];

const bars = [38, 72, 54, 24, 18, 62, 30];
---

<figure class="app-frame">
  <div class="app glass glass--solid">
    <div class="app__bar">
      <div>
        <span class="mono app__eyebrow">Calendario · noviembre</span>
        <strong class="app__title">Esta semana</strong>
      </div>
      <div class="app__user">
        <span class="avatar">JM</span>
        <span class="app__user-copy">
          <strong>Javi M.</strong>
          <span>Club Sierra · entrenador</span>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </div>
    </div>

    <div class="summary">
      <div class="summary__load">
        <span class="mono">Carga planificada</span>
        <strong class="summary__number">286<small>ECO</small></strong>
      </div>

      <div class="summary__chart" aria-hidden="true">
        {bars.map((height, index) => (
          <span class:list={['summary__bar', { 'is-today': index === 3 }]} style={`--h:${height}%`}></span>
        ))}
      </div>

      <div class="summary__meta">
        <span class="pill summary__pill"><span class="dot"></span> Semana 46</span>
        <span class="summary__delta">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
          8 % vs. anterior
        </span>
      </div>
    </div>

    <div class="week">
      <div class="week__head" aria-hidden="true">
        <span>Día</span>
        <span>Sesión</span>
        <span>Zona</span>
        <span>ECO</span>
      </div>

      {week.map((entry) => (
        <div class:list={['day', `day--${entry.sport}`, { 'is-today': entry.today }]}>
          <div class="day__date">
            <span class="day__dow">{entry.dow}</span>
            <span class="day__num">{entry.day}</span>
          </div>

          <div class="day__session">
            <span class="disc">
              <span class="disc__dot"></span>
              {entry.label}
            </span>
            <strong>{entry.title}</strong>
            <span class="day__hint">{entry.hint}</span>
          </div>

          <span class:list={['zone', `zone--${entry.zone.toLowerCase()}`]}>{entry.zone}</span>
          <span class="day__eco">{entry.eco}</span>
        </div>
      ))}
    </div>

    <div class="app__foot">
      <span>ECS medio <strong>6,4</strong></span>
      <span class="app__foot-sep" aria-hidden="true"></span>
      <span>Registros <strong>6 / 6</strong></span>
    </div>
  </div>

  <div class="float float--eco" aria-hidden="true">
    <span class="float__icon">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </span>
    <span class="float__copy">
      <span class="mono">Sesión interpretada</span>
      <strong>58 ECO</strong>
    </span>
  </div>

  <figcaption class="visually-hidden">
    Vista previa del calendario semanal de Sifos: sesiones de natación, bici, carrera, fuerza y
    descanso, con su zona y su carga ECO, además de la comparación entre carga planificada y
    esfuerzo percibido.
  </figcaption>
</figure>

<style>
  .app-frame {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 610px;
    filter: drop-shadow(0 40px 60px rgba(6, 55, 78, 0.16));
  }

  .app {
    --glass-strong: rgba(255, 255, 255, 0.9);
    --glass-soft: rgba(255, 255, 255, 0.68);
    position: relative;
    padding: 18px;
    border-radius: 30px;
  }

  .app__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 2px 4px 14px;
  }

  .app__eyebrow {
    color: var(--muted);
    font-size: 0.62rem;
  }

  .app__title {
    display: block;
    margin-top: 5px;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .app__user {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ink-soft);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    color: var(--on-accent);
    background: linear-gradient(150deg, #c3f3ff, #62cbea);
    box-shadow:
      inset 0 1px 0 #fff,
      0 4px 10px rgba(6, 55, 78, 0.12);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
  }

  .app__user-copy {
    display: grid;
    line-height: 1.25;
  }

  .app__user-copy strong {
    color: var(--ink);
    font-size: 0.78rem;
  }

  .app__user-copy span {
    color: var(--muted);
    font-size: 0.65rem;
  }

  .summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 13px 16px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .summary__load {
    display: grid;
    gap: 2px;
  }

  .summary__load .mono {
    color: var(--muted);
    font-size: 0.6rem;
  }

  .summary__number {
    font-family: var(--font-display);
    font-size: 2.05rem;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .summary__number small {
    margin-left: 5px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .summary__chart {
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 5px;
    height: 40px;
  }

  .summary__bar {
    width: 7px;
    height: var(--h);
    min-height: 6px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--accent-light), var(--accent-strong));
    opacity: 0.55;
  }

  .summary__bar.is-today {
    opacity: 1;
    background: linear-gradient(180deg, #ffc08e, var(--run));
    box-shadow: 0 0 0 3px rgba(242, 146, 74, 0.12);
  }

  .summary__meta {
    display: grid;
    justify-items: end;
    gap: 6px;
  }

  .summary__pill {
    padding: 5px 8px;
    color: var(--accent-deep);
    background: rgba(255, 255, 255, 0.6);
    font-size: 0.56rem;
  }

  .summary__delta {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: #1f7d4b;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 500;
  }

  .week {
    margin-top: 12px;
  }

  .week__head {
    display: grid;
    grid-template-columns: 46px 1fr 52px 44px;
    gap: 12px;
    padding: 8px 10px 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .week__head span:nth-child(3),
  .week__head span:nth-child(4) {
    text-align: center;
  }

  .day {
    display: grid;
    grid-template-columns: 46px 1fr 52px 44px;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-top: 1px solid var(--hairline-soft);
    border-radius: 12px;
  }

  .day.is-today {
    border-top-color: transparent;
    background: linear-gradient(100deg, rgba(242, 146, 74, 0.14), rgba(255, 255, 255, 0.32));
    box-shadow: inset 0 0 0 1px rgba(242, 146, 74, 0.2);
  }

  .day__date {
    display: grid;
    justify-items: start;
    gap: 2px;
    line-height: 1;
  }

  .day__dow {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .day__num {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .day.is-today .day__num {
    color: #b4531d;
  }

  .day__session {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .disc {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .disc__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rest);
  }

  .day--swim .disc__dot {
    background: var(--swim);
  }

  .day--bike .disc__dot {
    background: var(--bike);
  }

  .day--run .disc__dot {
    background: var(--run);
  }

  .day--strength .disc__dot {
    background: var(--strength);
  }

  .day__session strong {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.79rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .day__hint {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    line-height: 1.3;
  }

  .zone {
    justify-self: center;
    display: grid;
    place-items: center;
    width: 34px;
    height: 23px;
    border-radius: 7px;
    color: var(--ink-soft);
    background: rgba(11, 59, 82, 0.07);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
  }

  .zone--z1 {
    color: #1d5f8a;
    background: rgba(99, 170, 242, 0.2);
  }

  .zone--z2 {
    color: #1e7039;
    background: rgba(76, 194, 116, 0.2);
  }

  .zone--z4 {
    color: #a34816;
    background: rgba(242, 146, 74, 0.22);
  }

  .day__eco {
    justify-self: end;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .app__foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 10px 12px 2px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.04em;
  }

  .app__foot strong {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .app__foot-sep {
    width: 1px;
    height: 10px;
    background: var(--hairline);
  }

  .float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 15px;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.82));
    box-shadow:
      inset 0 1px 0 #fff,
      0 18px 40px rgba(6, 55, 78, 0.18);
  }

  .float--eco {
    top: -60px;
    left: 28px;
    animation: float-soft 7s ease-in-out infinite;
  }

  .float__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #1e7039;
    background: rgba(76, 194, 116, 0.18);
  }

  .float__copy {
    display: grid;
    gap: 1px;
  }

  .float__copy .mono {
    color: var(--muted);
    font-size: 0.5rem;
  }

  .float__copy strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.94rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 720px) {
    .app {
      padding: 14px;
      border-radius: 24px;
    }

    .app__bar {
      padding-bottom: 12px;
    }

    .app__user-copy {
      display: none;
    }

    .summary {
      grid-template-columns: auto 1fr;
      gap: 10px;
      padding: 11px 12px;
    }

    .summary__meta {
      display: none;
    }

    .summary__chart {
      justify-content: end;
    }

    .week__head,
    .day {
      grid-template-columns: 40px 1fr 44px;
      gap: 10px;
    }

    .week__head span:nth-child(3),
    .day > .zone {
      display: none;
    }

    .week__head span:nth-child(4) {
      display: block;
      text-align: right;
    }

    .day__eco {
      justify-self: end;
    }

    .float--eco {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .summary__number {
      font-size: 1.75rem;
    }

    .summary__chart {
      gap: 4px;
    }

    .summary__bar {
      width: 6px;
    }

    .day__session strong {
      white-space: normal;
    }
  }
</style>

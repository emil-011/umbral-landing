---
type WeekStatus = 'done' | 'current' | 'future';

const weeks: { label: string; plan: number; real: number | null; status: WeekStatus }[] = [
  { label: '2 nov', plan: 732.9, real: 953.6, status: 'done' },
  { label: '9 nov', plan: 783.9, real: 403.6, status: 'done' },
  { label: '16 nov', plan: 846.5, real: null, status: 'current' },
  { label: '23 nov', plan: 909.2, real: null, status: 'future' },
];

const round1 = (value: number) => Math.round(value * 10) / 10;
const num = (value: number, decimals = 0) =>
  value.toLocaleString('es-ES', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
    useGrouping: 'always',
  });

/** ECOp total suma el plan entero; la desviación compara solo las semanas ya cerradas. */
const closed = weeks.filter((week) => week.status === 'done');
const planTotal = round1(weeks.reduce((sum, week) => sum + week.plan, 0));
const closedPlan = round1(closed.reduce((sum, week) => sum + week.plan, 0));
const realTotal = round1(weeks.reduce((sum, week) => sum + (week.real ?? 0), 0));
const deviation = Math.round(((realTotal - closedPlan) / closedPlan) * 100);

const chartMax = 1000;
const barHeight = (value: number | null) => (value === null ? 0 : Math.round((value / chartMax) * 1000) / 10);

const ctl = [98, 96, 93, 89, 85, 80, 74, 68, 62, 58, 55, 54];
const atl = [38, 40, 43, 45, 42, 39, 41, 44, 46, 45, 44, 46];

const makeLine = (values: number[], width = 220, height = 70, pad = 4, max = 110) => {
  const step = (width - pad * 2) / (values.length - 1);
  const points = values.map((value, index) => {
    const x = pad + index * step;
    const y = pad + (1 - value / max) * (height - pad * 2);
    return [Number(x.toFixed(1)), Number(y.toFixed(1))] as const;
  });
  return {
    d: points.map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x} ${y}`).join(' '),
    width,
    height,
  };
};

const ctlLine = makeLine(ctl);
const atlLine = makeLine(atl);
---

<section class="u-band u-section" id="carga" aria-labelledby="u-load-title">
  <div class="u-wrap">
    <header class="u-head">
      <div>
        <p class="u-kicker">07 / La carga</p>
        <h2 class="u-title" id="u-load-title" data-split>
          Dos lecturas.<br />{' '}<span class="soft">Un mismo esfuerzo.</span>
        </h2>
      </div>
      <p class="u-head__note">
        <strong>ECOp</strong> es la carga que pide el plan; <strong>ECOr</strong>, la que sale de tu
        tiempo real en zona. Al lado, el ECS sentido y el TSS estándar, para poner la carga en
        perspectiva sin perder la lectura propia.
      </p>
    </header>

    <div class="u-kpis" data-reveal>
      <div class="u-kpi">
        <span class="u-mono">ECOp plan</span>
        <b>{num(planTotal)}</b>
        <small>{weeks.length} semanas de plan</small>
      </div>
      <div class="u-kpi">
        <span class="u-mono">ECOr real</span>
        <b>{num(realTotal)}</b>
        <small>{closed.length} semanas cerradas</small>
      </div>
      <div class="u-kpi">
        <span class="u-mono">Desviación a fecha</span>
        <b class="u-kpi__down">−{Math.abs(deviation)} %</b>
        <small>{num(closedPlan)} ECOp cerrados</small>
      </div>
      <div class="u-kpi">
        <span class="u-mono">TSS estimado</span>
        <b>{num(937)}</b>
        <small>Solo semanas con actividades</small>
      </div>
      <div class="u-kpi">
        <span class="u-mono">ECS medio</span>
        <b>2,6</b>
        <small>RPE del atleta · 1–10</small>
      </div>
    </div>

    <div class="u-loadgrid">
      <div class="u-loadchart u-panel-dark" data-reveal>
        <div class="u-loadchart__head">
          <div>
            <p class="u-mono">Carga</p>
            <h3>Planificado frente a hecho</h3>
          </div>
          <span class="u-chip">4 semanas</span>
        </div>

        <div class="u-chart" role="img" aria-label="Gráfica de ECO planificado y real por semana">
          <div class="u-chart__axis" aria-hidden="true">
            <span>1.000</span>
            <span>750</span>
            <span>500</span>
            <span>250</span>
            <span>0</span>
          </div>

          <div class="u-chart__plot">
            <div class="u-chart__grid" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>

            <div class="u-chart__bars">
              {weeks.map((week) => (
                <div
                  class:list={[
                    'u-chart__group',
                    week.status === 'future' && 'is-future',
                    week.status === 'current' && 'is-current',
                  ]}
                >
                  <div class="u-chart__pair">
                    <span
                      class="u-bar is-plan"
                      style={`height:${barHeight(week.plan)}%`}
                      data-bar-y
                      title={`ECOp ${num(week.plan, 1)}`}
                    ></span>
                    {week.real !== null ? (
                      <span
                        class="u-bar is-real"
                        style={`height:${barHeight(week.real)}%`}
                        data-bar-y
                        title={`ECOr ${num(week.real, 1)}`}
                      ></span>
                    ) : (
                      <span class="u-bar is-empty" aria-hidden="true"></span>
                    )}
                  </div>
                  <small>
                    {week.label}
                    {week.status === 'current' && <em> · en curso</em>}
                  </small>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="u-loadchart__foot">
          <div class="u-legend">
            <span><i class="is-plan"></i>ECOp · plan</span>
            <span><i class="is-real"></i>ECOr · hecho</span>
          </div>
          <p>
            Las semanas futuras solo tienen ECOp. La desviación compara las cerradas:{' '}
            <strong>{num(closedPlan)} ECOp</strong> frente a <strong>{num(realTotal)} ECOr</strong>.
          </p>
        </div>
      </div>

      <aside class="u-loadside">
        <div class="u-phase u-panel-dark" data-reveal>
          <div class="u-loadchart__head u-loadchart__head--tight">
            <div>
              <p class="u-mono">Fases</p>
              <h3>Reparto por fase</h3>
            </div>
            <span class="u-chip">Zonas</span>
          </div>

          <div class="u-phase__bar" aria-hidden="true">
            <span class="is-p1" style="width:62%" data-phase-bar></span>
            <span class="is-p2" style="width:30%" data-phase-bar></span>
            <span class="is-p3" style="width:8%" data-phase-bar></span>
          </div>
          <div class="u-phase__legend">
            <span><i class="is-p1"></i>Fase 1 · Aeróbica <b>62 %</b></span>
            <span><i class="is-p2"></i>Fase 2 · Transición <b>30 %</b></span>
            <span><i class="is-p3"></i>Fase 3 · Acumulación <b>8 %</b></span>
          </div>
          <p class="u-phase__note">
            Cada zona del entrenador se mapea a una de las tres fases metabólicas del modelo de
            Tschakert y Hofmann.
          </p>
        </div>

        <div class="u-form u-panel-dark" data-reveal>
          <div class="u-loadchart__head u-loadchart__head--tight">
            <div>
              <p class="u-mono">Forma</p>
              <h3>CTL, ATL y balance</h3>
            </div>
            <span class="u-chip">42 / 7 días</span>
          </div>

          <div class="u-form__stats">
            <div><span class="u-mono">CTL</span><b>54</b></div>
            <div><span class="u-mono">ATL</span><b>46</b></div>
            <div><span class="u-mono">TSB</span><b class="is-good">+8</b></div>
          </div>

          <svg class="u-form__chart" viewBox={`0 0 ${ctlLine.width} ${ctlLine.height}`} aria-hidden="true" focusable="false">
            <path class="u-form__line is-atl" d={atlLine.d} pathLength="1" data-draw />
            <path class="u-form__line is-ctl" d={ctlLine.d} pathLength="1" data-draw />
          </svg>

          <div class="u-form__legend">
            <span><i class="is-ctl"></i>CTL · crónica</span>
            <span><i class="is-atl"></i>ATL · aguda</span>
          </div>
          <p class="u-form__note">
            CTL es la media a 42 días; ATL, a 7. El TSB es su diferencia, cortada en hoy.
          </p>
        </div>
      </aside>
    </div>

    <div class="u-load__note" data-reveal>
      <p>
        <strong>ECOp</strong> es la carga que pide el plan. <strong>ECOr</strong> sale del tiempo real
        en cada zona. <strong>ECS</strong> es el RPE del atleta, de 1 a 10. <strong>TSS</strong> es la
        escala estándar, calculada con las referencias del perfil.
      </p>
      <p class="u-load__partial">
        Si falta una zona, un factor o una referencia, el bloque se marca parcial. No inventamos la
        carga.
      </p>
    </div>

    <p class="u-note u-load__demo">Datos de ejemplo · plan de cuatro semanas</p>
  </div>
</section>


---
const roles = [
  {
    id: 'coach',
    kicker: 'Entrenadores',
    title: 'Tu método, por fin medido.',
    text: 'Deja de reconstruir la semana en cinco sitios. Sifos guarda el plan, las zonas y la evolución en el mismo lugar donde decides la siguiente sesión.',
    points: [
      'Escribe el plan con tu vocabulario, no con bloques.',
      'Zonas y tests del club, centralizados.',
      'Revisa la sesión con vueltas y gráficas.',
      'Invita a entrenadores y atletas en un clic.',
    ],
  },
  {
    id: 'athlete',
    kicker: 'Atletas',
    title: 'Sabes qué toca y cuánto cuesta.',
    text: 'Un calendario que se entiende sin preguntar. Registra cómo te has sentido y mira cómo encaja tu esfuerzo con el plan de tu entrenador.',
    points: [
      'Cada sesión con su zona y su objetivo.',
      'Registra tu RPE en segundos.',
      'Tus ritmos y tests, siempre al día.',
      'Importa tus entrenos desde el reloj.',
    ],
  },
];
---

<section class="section audience" id="para-quien" aria-labelledby="audience-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">03 — Para quién</p>
      <h2 id="audience-title">Dos formas de mirar el mismo esfuerzo.</h2>
      <p class="lede">
        El entrenador necesita criterio para decidir. El atleta necesita claridad para ejecutar.
        Sifos no elige bando: pone a los dos en la misma conversación.
      </p>
    </div>

    <div class="roles">
      {roles.map((role) => (
        <article class:list={['role glass reveal', `role--${role.id}`]}>
          <div class="role__head">
            <span class:list={['role__badge', `role__badge--${role.id}`]}>{role.kicker}</span>
            <span class="role__icon" aria-hidden="true">
              {role.id === 'coach' ? (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19v-2a4 4 0 0 1 4-4h1"></path>
                  <circle cx="9" cy="7" r="3.2"></circle>
                  <path d="M15 11h5M15 15h5M17.5 7v8"></path>
                  <path d="M13 19h8"></path>
                </svg>
              ) : (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="5" r="2.6"></circle>
                  <path d="m8.5 21 1.9-6.2-3-3.4 2.4-4.1 4.2 3.1 3.4 1.1"></path>
                  <path d="m11.6 14.8 2.6 2.6 1.9 3.6"></path>
                </svg>
              )}
            </span>
          </div>

          <h3>{role.title}</h3>
          <p class="role__text">{role.text}</p>

          <ul class="role__list">
            {role.points.map((point) => (
              <li>
                <span class:list={['role__tick', `role__tick--${role.id}`]} aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                </span>
                {point}
              </li>
            ))}
          </ul>

          {role.id === 'coach' ? (
            <div class="mini mini--coach" aria-hidden="true">
              <div class="mini__head">
                <span class="mono">Asignar plan</span>
                <span class="pill">Grupo Élite</span>
              </div>
              <div class="mini__row">
                <span class="mini__mark">N</span>
                <span class="mini__copy">
                  <strong>Noviembre · Base 2</strong>
                  <span>16 atletas · 24 sesiones</span>
                </span>
                <span class="mini__action">Asignar</span>
              </div>
              <div class="mini__foot">
                <span class="mini__avatars"><span>LM</span><span>AR</span><span>+14</span></span>
                <span>Se avisa a todo el grupo</span>
              </div>
            </div>
          ) : (
            <div class="mini mini--athlete" aria-hidden="true">
              <div class="mini__head">
                <span class="mono">¿Cómo ha ido?</span>
                <span class="mini__rpe">RPE <strong>7</strong></span>
              </div>
              <div class="mini__scale">
                {Array.from({ length: 10 }).map((_, index) => (
                  <span class:list={['mini__step', { 'is-on': index < 7 }]}>{index + 1}</span>
                ))}
              </div>
              <div class="mini__row mini__row--session">
                <span class="mini__sport"><span class="dot"></span> Carrera</span>
                <span class="mini__session">8 × 400 m UA</span>
                <span class="mini__eco">58 ECO</span>
              </div>
              <div class="mini__foot">
                <span>Guardado a las 19:42</span>
                <span class="mini__done">Listo</span>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .audience {
    padding-top: clamp(54px, 6vw, 78px);
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(38px, 4.5vw, 56px);
  }

  .role {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 34px);
    overflow: hidden;
  }

  .role--coach {
    background:
      radial-gradient(480px 300px at 100% 100%, rgba(56, 179, 229, 0.18), transparent 70%) padding-box,
      linear-gradient(155deg, var(--glass-strong), var(--glass-soft)) padding-box;
  }

  .role--athlete {
    background:
      radial-gradient(480px 300px at 100% 100%, rgba(242, 146, 74, 0.16), transparent 70%) padding-box,
      linear-gradient(155deg, var(--glass-strong), var(--glass-soft)) padding-box;
  }

  .role__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .role__badge {
    display: inline-flex;
    padding: 6px 10px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .role__badge--coach {
    color: #1d5f8a;
    background: rgba(99, 170, 242, 0.16);
  }

  .role__badge--athlete {
    color: #a34816;
    background: rgba(242, 146, 74, 0.16);
  }

  .role__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 14px;
    color: var(--accent-deep);
    background: rgba(255, 255, 255, 0.46);
    box-shadow: inset 0 1px 0 #fff;
  }

  .role--athlete .role__icon {
    color: #b4531d;
  }

  .role h3 {
    max-width: 14ch;
    margin-top: 24px;
    font-size: clamp(1.7rem, 2.6vw, 2.25rem);
    line-height: 1.02;
  }

  .role__text {
    max-width: 46ch;
    margin-top: 12px;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .role__list {
    display: grid;
    gap: 10px;
    margin-top: 22px;
    color: var(--ink-soft);
    font-size: 0.86rem;
  }

  .role__list li {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .role__tick {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    flex: none;
    border-radius: 50%;
    color: #1d5f8a;
    background: rgba(99, 170, 242, 0.18);
  }

  .role__tick--athlete {
    color: #a34816;
    background: rgba(242, 146, 74, 0.18);
  }

  /* ---------- Mini interfaces ---------- */

  .mini {
    margin-top: auto;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.44);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .mini--coach {
    margin-top: 28px;
  }

  .mini--athlete {
    margin-top: 28px;
  }

  .mini__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .mini__head .mono {
    color: var(--muted);
    font-size: 0.53rem;
  }

  .mini__head .pill {
    padding: 4px 7px;
    font-size: 0.47rem;
  }

  .mini__row {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 12px 0 2px;
  }

  .mini__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 9px;
    color: var(--on-accent);
    background: linear-gradient(150deg, #cff6ff, #7fd6ee);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .mini__copy {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .mini__copy strong {
    color: var(--ink);
    font-size: 0.76rem;
  }

  .mini__copy span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
  }

  .mini__action {
    margin-left: auto;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent-light), var(--accent-strong));
    font-size: 0.6rem;
    font-weight: 700;
  }

  .mini__foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 11px;
    padding-top: 10px;
    border-top: 1px solid var(--hairline-soft);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.49rem;
  }

  .mini__avatars {
    display: flex;
    flex: none;
  }

  .mini__avatars span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-left: -4px;
    border: 1.5px solid #fff;
    border-radius: 50%;
    color: var(--on-accent);
    background: linear-gradient(150deg, #e2faff, #9ee4f5);
    font-family: var(--font-mono);
    font-size: 0.4rem;
    font-weight: 700;
  }

  .mini__avatars span:first-child {
    margin-left: 0;
  }

  .mini__rpe {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  .mini__rpe strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .mini__scale {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 3px;
    padding: 13px 0 5px;
  }

  .mini__step {
    display: grid;
    place-items: center;
    height: 25px;
    border-radius: 6px;
    color: var(--muted);
    background: rgba(11, 59, 82, 0.05);
    font-family: var(--font-mono);
    font-size: 0.47rem;
  }

  .mini__step.is-on {
    color: #8a3d12;
    background: linear-gradient(180deg, rgba(255, 192, 142, 0.8), rgba(242, 146, 74, 0.72));
    font-weight: 700;
  }

  .mini__row--session {
    padding-top: 9px;
  }

  .mini__sport {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .mini__sport .dot {
    color: var(--run);
  }

  .mini__session {
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .mini__eco {
    margin-left: auto;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    font-weight: 600;
  }

  .mini__done {
    margin-left: auto;
    color: #1f7d4b;
    font-weight: 600;
  }

  @media (max-width: 880px) {
    .roles {
      grid-template-columns: 1fr;
    }

    .role h3 {
      max-width: none;
    }

    .role__text {
      max-width: 56ch;
    }
  }

  @media (max-width: 480px) {
    .role {
      padding: 20px;
    }

    .mini {
      padding: 12px;
    }

    .mini__step {
      height: 22px;
      font-size: 0.42rem;
    }

    .mini__session {
      font-size: 0.63rem;
    }
  }
</style>

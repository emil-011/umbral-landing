  }

  .u-poster__route-halo {
    fill: none;
    stroke: var(--signal);
    stroke-width: 8;
    stroke-opacity: 0.12;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .u-poster__lapmark circle {

    left: 12px;
    z-index: 2;
    padding: 4px 7px;
    border-radius: 999px;
    color: var(--stone);
    background: rgba(25, 26, 24, 0.72);
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-poster__map-bg {
    fill: #171814;
  }

  .u-poster__streets path {

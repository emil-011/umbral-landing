---
import DiscIcon from './DiscIcon.astro';

const features = [
  {
    n: '01',
    title: 'Mapa y vueltas',
    text: 'El recorrido completo y cada parcial, con FC, potencia y cadencia.',
  },
  {
    n: '02',
    title: 'Plan frente a hecho',
    text: 'Tiempo en zona y desvío, sin abrir una hoja de cálculo.',
  },
  {
    n: '03',
    title: 'Potencia y FC',
    text: 'La evolución de la sesión, importada del reloj.',
  },
];

const zones = [
  { label: 'Z1', level: 'z1', actual: 8, pct: '67 %' },
  { label: 'Z2', level: 'z2', actual: 26, pct: '96 %' },
  { label: 'Z3', level: 'z3', actual: 28, pct: '140 %', over: true },
  { label: 'Z4', level: 'z4', actual: 14, pct: '88 %' },
  { label: 'Z5', level: 'z5', actual: 3, pct: '—' },
];

const laps = [
  { n: '1', time: '4:00', power: '338 W', selected: true },
  { n: '2', time: '3:00', power: '182 W', selected: false },
  { n: '3', time: '4:00', power: '341 W', selected: false },
  { n: '4', time: '3:00', power: '185 W', selected: false },
];

const powerValues = [
  190, 210, 230, 250, 270, 265, 240, 225, 245, 280, 300, 290, 260, 235, 250, 275,
  295, 280, 255, 230, 245, 260, 275, 290, 270, 245, 230, 215, 205, 198, 190, 185,
];
const hrValues = [
  115, 125, 135, 145, 152, 158, 160, 155, 150, 155, 165, 168, 165, 158, 152, 155,
  162, 166, 160, 152, 148, 150, 155, 160, 158, 152, 148, 144, 140, 136, 132, 130,
];

const chartW = 560;
const chartH = 200;
const chartPad = 12;

const makeLine = (values: number[], min: number, max: number) => {
  const range = max - min || 1;
  return values.map((value, index) => {
    const x = chartPad + (index * (chartW - chartPad * 2)) / (values.length - 1);
    const y = chartPad + (1 - (value - min) / range) * (chartH - chartPad * 2);
    return [Number(x.toFixed(1)), Number(y.toFixed(1))] as const;
  });
};

const powerPoints = makeLine(powerValues, Math.min(...powerValues), Math.max(...powerValues));
const powerPath = powerPoints.map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x} ${y}`).join(' ');
const powerArea = `${powerPath} L${chartW - chartPad} ${chartH - chartPad} L${chartPad} ${chartH - chartPad} Z`;
const hrPoints = makeLine(hrValues, Math.min(...hrValues), Math.max(...hrValues));
const hrPath = hrPoints.map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x} ${y}`).join(' ');

/**
 * Ruta de ejemplo por la retícula de calles. Las esquinas se redondean como
 * en un trazado GPS real en vez de dejar un polígono de ángulos rectos.
 */
const routeWaypoints: [number, number][] = [
  [62, 300],
  [62, 150],
  [186, 150],
  [186, 100],
  [434, 100],
  [434, 200],
  [310, 200],
  [310, 300],
  [186, 300],
];

const roundedRoute = (points: [number, number][], radius = 10) => {
  const dist = (a: [number, number], b: [number, number]) => Math.hypot(b[0] - a[0], b[1] - a[1]);
  let d = `M${points[0][0]} ${points[0][1]}`;
  for (let i = 1; i < points.length - 1; i++) {
    const prev = points[i - 1];
    const curr = points[i];
    const next = points[i + 1];
    const inLen = dist(prev, curr);
    const outLen = dist(curr, next);
    const r = Math.min(radius, inLen / 2, outLen / 2);
    const ax = curr[0] - ((curr[0] - prev[0]) / inLen) * r;
    const ay = curr[1] - ((curr[1] - prev[1]) / inLen) * r;
    const bx = curr[0] + ((next[0] - curr[0]) / outLen) * r;
    const by = curr[1] + ((next[1] - curr[1]) / outLen) * r;
    d += ` L${ax.toFixed(1)} ${ay.toFixed(1)} Q${curr[0]} ${curr[1]} ${bx.toFixed(1)} ${by.toFixed(1)}`;
  }
  const last = points[points.length - 1];
  return `${d} L${last[0]} ${last[1]}`;
};

const routePath = roundedRoute(routeWaypoints);
---

<section class="u-section u-track-feature" id="seguimiento" aria-labelledby="u-track-title">
  <div class="u-wrap">
    <header class="u-head">
      <div>
        <p class="u-kicker">06 / Seguimiento</p>
        <h2 class="u-title" id="u-track-title" data-split>
          Lo que de verdad<br />{' '}<span class="soft">pasó.</span>
        </h2>
      </div>
      <p class="u-head__note">
        Las actividades llegan del reloj y se cruzan con la sesión planificada. <strong>Mapa, vueltas,
        zonas y gráficas</strong>, en una sola lectura.
      </p>
    </header>

    <div class="u-track-feature__grid">
      <div class="u-track-feature__copy" data-reveal>
        <p class="u-track-feature__lead">
          Una sesión no es una captura. Es un recorrido, unas vueltas y una comparación con lo que
          tocaba.
        </p>

        <ul class="u-track-feature__list">
          {features.map((feature) => (
            <li>
              <span>{feature.n}</span>
              <div>
                <strong>{feature.title}</strong>
                <p>{feature.text}</p>
              </div>
            </li>
          ))}
        </ul>

        <p class="u-note">Datos de ejemplo · actividad importada</p>
      </div>

      <div class="u-poster" data-reveal>
        <header class="u-poster__head">
          <span class="u-poster__sport">Ciclismo</span>
          <span class="u-poster__date">mar, 17 nov · Grupo Élite</span>
          <span class="u-poster__state"><i class="u-dot" aria-hidden="true"></i>Importada</span>
        </header>

        <div class="u-poster__hero">
          <b>1:19</b>
          <span class="u-poster__dist">40,2 km</span>
          <div class="u-poster__nums">
            <span><b>221</b> W</span>
            <span><b>149</b> ppm</span>
            <span><b>4</b> vueltas</span>
          </div>
        </div>

        <div class="u-poster__map">
          <span class="u-poster__tag">Recorrido</span>
          <svg class="u-poster__map-svg" viewBox="0 0 600 320" aria-hidden="true" focusable="false">
            <defs>
              <pattern id="u-map-block" width="62" height="50" patternUnits="userSpaceOnUse">
                <rect
                  x="4"
                  y="4"
                  width="54"
                  height="42"
                  rx="1.5"
                  fill="#f0ede5"
                  fill-opacity="0.032"
                  stroke="#f0ede5"
                  stroke-opacity="0.055"
                  stroke-width="1"
                />
              </pattern>
            </defs>

            <rect class="u-poster__map-bg" width="600" height="320" />
            <rect width="600" height="320" fill="url(#u-map-block)" />

            <g class="u-poster__streets">
              <path d="M124 -10V330" stroke-width="5" />
              <path d="M310 -10V330" stroke-width="5" />
              <path d="M434 -10V330" stroke-width="5" />
              <path d="M-10 100H610" stroke-width="5" />
              <path d="M-10 200H610" stroke-width="5" />
              <path d="M-10 300H610" stroke-width="5" />
              <path d="M-30 350 340 -20" stroke-width="7" />
              <path d="M-20 60 280 350" stroke-width="3" />
            </g>

            <g class="u-poster__park">
              <rect x="204" y="212" width="92" height="70" rx="10" />
              <g class="u-poster__trees">
                <circle cx="224" cy="232" r="2.6" />
                <circle cx="246" cy="240" r="2.2" />
                <circle cx="270" cy="230" r="2.6" />
                <circle cx="236" cy="258" r="2.2" />
                <circle cx="262" cy="264" r="2.6" />
                <circle cx="282" cy="248" r="2.2" />
              </g>
            </g>

            <path
              class="u-poster__water"
              d="M600 206C572 214 546 228 526 250C505 274 496 300 490 330L620 330Z"
            />
            <path
              class="u-poster__beach"
              d="M600 206C572 214 546 228 526 250C505 274 496 300 490 330"
            />
            <path
              class="u-poster__coast"
              d="M600 206C572 214 546 228 526 250C505 274 496 300 490 330"
            />
            <g class="u-poster__marina">
              <path d="M536 240 568 231" />
              <path d="M516 264 546 257" />
              <path d="M500 292 528 287" />
              <rect x="563" y="227" width="9" height="4" rx="2" />
              <rect x="541" y="254" width="8" height="3.5" rx="1.75" />
              <rect x="523" y="284" width="7" height="3.5" rx="1.75" />
            </g>
            <g class="u-poster__waves">
              <path d="M524 272c9-3 15 3 24 0s15 3 24 0" />
              <path d="M512 296c9-3 15 3 24 0s15 3 24 0" />
            </g>

            <text class="u-poster__maplabel" x="210" y="226">PARQUE</text>
            <text class="u-poster__maplabel is-water" x="536" y="306">BAHÍA</text>

            <path class="u-poster__route-halo" d={routePath} />
            <path
              class="u-poster__route"
              d={routePath}
              pathLength="1"
              data-draw
              data-track-route
            />

            <g class="u-poster__lapmark">
              <circle cx="62" cy="212" r="6.6" />
              <text x="62" y="214.4">1</text>
              <circle cx="186" cy="124" r="6.6" />
              <text x="186" y="126.4">2</text>
              <circle cx="372" cy="100" r="6.6" />
              <text x="372" y="102.4">3</text>
            </g>

            <g class="u-poster__compass">
              <circle cx="566" cy="30" r="11" />
              <path d="M566 22 570 34 566 31 562 34Z" />
              <text x="566" y="18">N</text>
            </g>

            <circle class="u-poster__start" cx="62" cy="300" r="4.4" />
            <circle class="u-poster__end" cx="186" cy="300" r="4.4" />
            <g class="u-poster__runner" data-track-runner>
              <circle class="u-poster__runner-halo" cx="62" cy="300" r="8" />
              <circle class="u-poster__runner-dot" cx="62" cy="300" r="3.6" />
            </g>
          </svg>
        </div>

        <div class="u-poster__plan">
          <span>Plan <b>1:15</b></span>
          <span class="u-poster__planbar" aria-hidden="true">
            <i data-meter style="width:100%"></i>
            <em style="left:95%"></em>
          </span>
          <span>Hecho <b>1:19</b></span>
          <strong>+5 %</strong>
        </div>

        <div class="u-poster__strip">
          <div class="u-poster__col">
            <span class="u-poster__caption">Tiempo en zona</span>
            <div class="u-poster__zbars">
              {zones.map((zone) => (
                <span class="u-poster__zbar">
                  <i class={`is-${zone.level}`} style={`height:${(zone.actual / 30) * 100}%`} data-bar-y></i>
                  <small>{zone.label}</small>
                  <b class:list={[zone.over && 'is-over']}>{zone.pct}</b>
                </span>
              ))}
            </div>
          </div>

          <div class="u-poster__col">
            <span class="u-poster__caption">Vueltas</span>
            <div class="u-poster__laps">
              {laps.map((lap) => (
                <span class:list={['u-poster__lap', lap.selected && 'is-selected']}>
                  <b>#{lap.n}</b>
                  <span>{lap.time}</span>
                  <small>{lap.power}</small>
                </span>
              ))}
            </div>
          </div>

          <div class="u-poster__col">
            <span class="u-poster__caption">Potencia y FC</span>
            <svg class="u-poster__chart" viewBox={`0 0 ${chartW} ${chartH}`} aria-hidden="true" focusable="false">
              <path class="u-poster__area" d={powerArea} />
              <path class="u-poster__power" d={powerPath} pathLength="1" data-draw />
              <path class="u-poster__hr" d={hrPath} pathLength="1" data-draw />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .u-track-feature__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.24fr);
    align-items: center;
    gap: clamp(28px, 4.4vw, 64px);
  }

  .u-track-feature__copy {
    min-width: 0;
  }

  .u-track-feature__lead {
    max-width: 36ch;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.4vw, 1.28rem);
    line-height: 1.6;
  }

  .u-track-feature__list {
    display: grid;
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }

  .u-track-feature__list li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .u-track-feature__list > li > span {
    padding-top: 2px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.08em;
  }

  .u-track-feature__list strong {
    display: block;
    color: var(--ink);
    font-family: var(--display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .u-track-feature__list p {
    margin-top: 3px;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.5;
  }

  .u-track-feature__copy .u-note {
    margin-top: 20px;
  }

  /* ===================== Póster ===================== */

  .u-poster {
    position: relative;
    overflow: hidden;
    padding: 22px 24px 20px;
    border: 1px solid #34352f;
    border-radius: 30px;
    color: var(--ivory);
    background:
      repeating-linear-gradient(90deg, transparent 0 47px, rgba(240, 237, 229, 0.035) 47px 48px),
      repeating-linear-gradient(0deg, transparent 0 47px, rgba(240, 237, 229, 0.035) 47px 48px),
      var(--ink);
  }

  @supports (corner-shape: squircle) {
    .u-poster {
      corner-shape: squircle;
    }
  }

  .u-poster__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }

  .u-poster__sport {
    color: var(--ivory);
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .u-poster__date {
    color: var(--stone);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .u-poster__state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--stone);
    font-family: var(--mono);
    font-size: 7.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


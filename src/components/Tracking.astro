  }

  .u-poster__start {
    fill: var(--signal);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .u-poster__end {
    fill: var(--ivory);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .u-poster__runner {
    opacity: 0.95;
    filter: drop-shadow(0 0 6px rgba(32, 212, 88, 0.7));
  }

  .u-poster__runner-halo {
    fill: var(--signal);
    opacity: 0.18;
  }

  .u-poster__runner-dot {
    fill: var(--signal);
  }

  .u-poster__plan {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 10px;
    margin-top: 12px;
  }

  .u-poster__plan > span {
    color: var(--stone);
    font-family: var(--mono);
    font-size: 7.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .u-poster__plan b {
    color: var(--ivory);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .u-poster__planbar {
    position: relative;
    flex: 1;
    height: 4px;
    min-width: 80px;
    border-radius: 99px;
    background: #353630;
  }

  .u-poster__planbar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--signal);
    transform-origin: left;

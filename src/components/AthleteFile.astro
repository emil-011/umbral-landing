---
import DiscIcon from './DiscIcon.astro';

const clock = (seconds: number) => {
  const whole = Math.round(seconds);
  return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, '0')}`;
};

const toSeconds = (pace: string) => {
  const [minutes, seconds] = pace.split(':').map(Number);
  return minutes * 60 + seconds;
};

const zoneNames = ['Recuperación', 'Aeróbico', 'Tempo', 'Umbral', 'VO₂ máx.'];
const swimDistances = [50, 100, 200, 400, 800];

const athlete = {
  name: 'Marta López',
  nickname: 'marta',
  initials: 'ML',
  group: 'Élite',
  club: 'Club Triatlón Élite',
  tests: {
    swim: [
      { dist: 50, time: 35, date: '14 may', active: false },
      { dist: 100, time: 76, date: '14 may', active: false },
      { dist: 200, time: 168, date: '02 may', active: false },
      { dist: 400, time: 352, date: '02 may', active: true },
      { dist: 800, time: 750, date: '18 abr', active: false },
    ],
    run: [
      { dist: 5000, time: 1215, date: '10 may', active: true },
      { dist: 10000, time: 2580, date: '22 mar', active: false },
    ],
    bike: [
      { power: 285, time: 1200, ftp: 271, date: '05 may', active: true },
      { power: 272, time: 1200, ftp: 258, date: '15 feb', active: false },
    ],
  },
  zones: ['1:47', '1:42', '1:37', '1:32', '1:26'],
  runPaces: ['5:45', '5:12', '4:48', '4:24', '4:02'],
  ftp: 271,
  watts: [190, 216, 244, 271, 298],
  stats: {
    kpis: [
      { label: 'Sesiones', value: '12' },
      { label: 'Tiempo', value: '8 h 40' },
      { label: 'Distancia', value: '68 km' },
      { label: 'Desnivel', value: '1.240 m' },
      { label: 'TSS estimado', value: '410' },
    ],
    weeks: [
      [18, 42, 25], [20, 50, 30], [16, 38, 22], [24, 55, 34], [22, 48, 28], [20, 52, 32],
      [18, 44, 26], [26, 58, 36], [22, 50, 30], [24, 56, 34], [20, 46, 28], [28, 62, 40],
    ],
    disciplines: [
      { name: 'Natación', sessions: 4, time: '2 h 10', distance: '6,2 km' },
      { name: 'Ciclismo', sessions: 4, time: '3 h 30', distance: '82 km' },
      { name: 'Carrera', sessions: 4, time: '3 h 00', distance: '32 km' },
    ],
  },
};

const slides = [
  { feature: 'ritmos', aria: 'ritmos de entrenamiento' },
  { feature: 'stats', aria: 'estadísticas del atleta' },
  { feature: 'tests', aria: 'tests del atleta' },
];

const swim400 = athlete.tests.swim.find((test) => test.dist === 400);
const swimPace = swim400 ? clock(swim400.time / (swim400.dist / 100)) : '—';
const maxWeek = Math.max(...athlete.stats.weeks.map(([swim, bike, run]) => swim + bike + run));
const heatWeeks = Array.from({ length: 12 }, (_, week) =>
  Array.from({ length: 7 }, (_, day) => (week * 3 + day * 2 + (week * day) % 5) % 5),
);
const activeWeeks = heatWeeks.filter((week) => week.some((level) => level > 0)).length;
---

<section class="u-section" id="ficha" aria-labelledby="u-ficha-title">
  <div class="u-wrap">
    <header class="u-head">
      <div>
        <p class="u-kicker">04 / La ficha</p>
        <h2 class="u-title" id="u-ficha-title" data-split>
          Cada atleta,<br />{' '}<span class="soft">con sus marcas.</span>
        </h2>
      </div>
    </header>

    <div class="u-fiche-carousel" data-fiche-carousel role="group" aria-roledescription="carrusel" aria-label="Pantallas de la ficha de atleta">
      <div class="u-fiche-carousel__ui">
        <span class="u-mono" data-fiche-count aria-hidden="true">01 / {String(slides.length).padStart(2, '0')}</span>
        <span class="u-fiche-carousel__progress" aria-hidden="true">
          <i class="u-fiche-carousel__bar" data-fiche-progress></i>
        </span>
        <span class="u-fiche-carousel__dots">
          {slides.map((slide, index) => (
            <button
              class:list={['u-fiche-dot', index === 0 && 'is-active']}
              type="button"
              data-fiche-dot={index}
              aria-label={`Ir a ${slide.aria}`}
              aria-current={index === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </span>
        <button class="u-fiche-carousel__toggle" type="button" data-fiche-toggle aria-label="Pausar el carrusel" aria-pressed="false">
          <svg class="is-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16" rx="1" />
            <rect x="14" y="4" width="4" height="16" rx="1" />
          </svg>
          <svg class="is-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>

      <div class="u-fiche-stage">
        <div class="u-fiche-viewport" data-fiche-viewport>
          <div class="u-fiche-track" data-fiche-track>
            {slides.map((slide, index) => (
              <article
                class:list={['u-fiche-slide', index === 0 && 'is-active']}
                data-fiche-slide={index}
                role="group"
                aria-roledescription="diapositiva"
                aria-label={slide.aria}
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <div class="u-fiche-slide__card">
                  {slide.feature === 'tests' && (
                    <>
                      <header class="u-profile-head u-slide-anim">
                        <span class="u-profile-avatar" aria-hidden="true">{athlete.initials}</span>
                        <div class="u-profile-who">
                          <p class="u-profile-eyebrow">Perfil del atleta</p>
                          <h3>{athlete.name}</h3>
                          <p class="u-profile-meta">@{athlete.nickname} · {athlete.club}</p>
                        </div>
                        <span class="u-btn u-btn--sm u-btn--ghost u-profile-back" aria-hidden="true">Volver al club</span>
                      </header>

                      <div class="u-profile-tests u-slide-anim">
                        <section class="u-app-panel u-test-block">
                          <div class="u-test-block__head">
                            <span class="u-dot-disc is-run" aria-hidden="true"></span>
                            <h4>Tests de carrera</h4>
                          </div>
                          <div class="u-test-rows">
                            {athlete.tests.run.map((test) => (
                              <div class:list={['u-test-row', test.active && 'is-active']}>
                                <span class="u-test-date">{test.date}</span>
                                <strong>{test.dist / 1000} km</strong>
                                <span class="u-test-value">{clock(test.time)}</span>
                                <span class="u-test-pace">{clock(test.time / (test.dist / 1000))}<small>/km</small></span>
                                <span class="u-test-state">{test.active && <span class="u-chip is-active">Activo</span>}</span>
                              </div>
                            ))}
                          </div>
                        </section>

                        <section class="u-app-panel u-test-block">
                          <div class="u-test-block__head">
                            <span class="u-dot-disc is-bike" aria-hidden="true"></span>
                            <h4>Tests de bici</h4>
                          </div>
                          <div class="u-test-rows">
                            {athlete.tests.bike.map((test) => (
                              <div class:list={['u-test-row', test.active && 'is-active']}>
                                <span class="u-test-date">{test.date}</span>
                                <strong>{test.power} W</strong>
                                <span class="u-test-value">{clock(test.time)}</span>
                                <span class="u-test-pace">{test.ftp}<small>W FTP</small></span>
                                <span class="u-test-state">{test.active && <span class="u-chip is-active">Activo</span>}</span>
                              </div>
                            ))}
                          </div>
                        </section>

                        <section class="u-app-panel u-test-block">
                          <div class="u-test-block__head">
                            <span class="u-dot-disc is-swim" aria-hidden="true"></span>
                            <h4>Tests de natación</h4>
                          </div>
                          <div class="u-test-rows">
                            {athlete.tests.swim.map((test) => (
                              <div class:list={['u-test-row', test.active && 'is-active']}>
                                <span class="u-test-date">{test.date}</span>
                                <strong>{test.dist} m</strong>
                                <span class="u-test-value">{clock(test.time)}</span>
                                <span class="u-test-pace">{clock(test.time / (test.dist / 100))}<small>/100 m</small></span>
                                <span class="u-test-state">{test.active && <span class="u-chip is-active">Activo</span>}</span>
                              </div>
                            ))}
                          </div>
                        </section>
                      </div>

                      <p class="u-fiche-slide__foot u-note">
                        El test activo fija la referencia de cada disciplina.
                      </p>
                    </>
                  )}

                  {slide.feature === 'ritmos' && (
                    <>
                      <header class="u-profile-head u-slide-anim">
                        <span class="u-profile-avatar" aria-hidden="true">{athlete.initials}</span>
                        <div class="u-profile-who">
                          <p class="u-profile-eyebrow">Perfil del atleta</p>
                          <h3>{athlete.name}</h3>
                          <p class="u-profile-meta">@{athlete.nickname} · {athlete.club}</p>
                        </div>
                        <span class="u-btn u-btn--sm u-btn--ghost u-profile-back" aria-hidden="true">Volver al club</span>
                      </header>

                      <section class="u-app-panel u-paces-panel u-slide-anim">
                        <div class="u-paces-head">
                          <h4>Ritmos de entrenamiento</h4>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                        </div>

                        <div class="u-pace-group">
                          <div class="u-pace-group__head">
                            <span class="u-disc u-disc--run"><DiscIcon disc="RUN" />Carrera</span>
                            <span class="u-pace-current">{athlete.runPaces[3]}<small>/km</small></span>
                          </div>
                          <div class="u-zone-chips">
                            {athlete.runPaces.map((pace, zoneIndex) => (
                              <span class:list={['u-zone-chip', zoneIndex === 3 && 'is-pivot']} style={`--zc: var(--z${zoneIndex + 1})`} title={zoneNames[zoneIndex]}>
                                <span class="u-zone-chip__dot" aria-hidden="true"></span>
                                <span class="u-zone-chip__short">Z{zoneIndex + 1}</span>
                                <span class="u-zone-chip__value">{pace}<small>/km</small></span>
                              </span>
                            ))}
                          </div>
                        </div>

                        <div class="u-pace-group">
                          <div class="u-pace-group__head">
                            <span class="u-disc u-disc--bike"><DiscIcon disc="BIKE" />Bici</span>
                            <span class="u-pace-current">{athlete.ftp}<small>W FTP</small></span>
                          </div>
                          <div class="u-zone-chips">
                            {athlete.watts.map((watts, zoneIndex) => (
                              <span class:list={['u-zone-chip', zoneIndex === 3 && 'is-pivot']} style={`--zc: var(--z${zoneIndex + 1})`} title={zoneNames[zoneIndex]}>
                                <span class="u-zone-chip__dot" aria-hidden="true"></span>
                                <span class="u-zone-chip__short">Z{zoneIndex + 1}</span>
                                <span class="u-zone-chip__value">{watts}<small>W</small></span>
                              </span>
                            ))}
                          </div>
                        </div>

                        <div class="u-pace-group">
                          <div class="u-pace-group__head">
                            <span class="u-disc u-disc--swim"><DiscIcon disc="SWIM" />Natación</span>
                            <span class="u-pace-current">{swimPace}<small>/100 m</small></span>
                          </div>
                          <div class="u-swim-matrix" style={`grid-template-columns: 58px repeat(${swimDistances.length}, minmax(0, 1fr))`}>
                            <span></span>
                            {swimDistances.map((distance) => (
                              <span class="u-swim-matrix__distance">{distance} m</span>
                            ))}
                            {athlete.zones.map((pace, zoneIndex) => {
                              const paceSeconds = toSeconds(pace);
                              return (
                                <>
                                  <span class="u-swim-matrix__zone" style={`--zc: var(--z${zoneIndex + 1})`}>
                                    <i aria-hidden="true"></i>Z{zoneIndex + 1}
                                  </span>
                                  {swimDistances.map((distance) => (
                                    <span class="u-swim-matrix__cell">
                                      <b>{clock((paceSeconds * distance) / 100)}</b>
                                      <small>{pace}</small>
                                    </span>
                                  ))}
                                </>
                              );
                            })}
                          </div>
                          <p class="u-swim-matrix__note">Tiempo total (arriba) y ritmo por 100 m (abajo).</p>
                        </div>
                      </section>

                      <p class="u-fiche-slide__foot u-note">
                        Los ritmos se recalculan al cambiar el test activo.
                      </p>
                    </>
                  )}

                  {slide.feature === 'stats' && (
                    <>
                      <header class="u-stats-head u-slide-anim">
                        <p class="u-stats-tech">Umbral / análisis</p>
                        <h3>Estadísticas</h3>
                        <p class="u-stats-lead">
                          Qué has entrenado, cuánta carga has acumulado y dónde has puesto el tiempo.
                          Tres lecturas separadas para no mezclar volumen con intensidad.
                        </p>
                      </header>

                      <div class="u-stats-toolbar u-slide-anim">
                        <div class="u-stats-tabs" aria-hidden="true">
                          <span class="is-active">Resumen</span>
                          <span>Carga</span>
                          <span>Distribución</span>
                        </div>
                        <span class="u-stats-filter" aria-hidden="true">
                          <span>Atleta</span>
                          <b>{athlete.name}</b>
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                        </span>
                      </div>

                      <div class="u-stats-kpis u-slide-anim">
                        {athlete.stats.kpis.map((kpi) => (
                          <div class="u-app-panel u-stats-kpi">
                            <span class="u-mono">{kpi.label}</span>
                            <b>{kpi.value}</b>
                          </div>
                        ))}
                      </div>

                      <div class="u-stats-grid u-slide-anim">
                        <section class="u-app-panel u-stats-panel">
                          <div class="u-stats-panel__head">
                            <div>
                              <span class="u-mono">Volumen</span>
                              <h4>Horas por disciplina</h4>
                            </div>
                            <span class="u-stats-unit" aria-hidden="true"><b>Horas</b><span>Km</span></span>
                          </div>
                          <div class="u-chart" aria-hidden="true">
                            {athlete.stats.weeks.map(([swim, bike, run]) => {
                              const total = swim + bike + run;
                              return (
                                <span class="u-chart__col" style={`--h:${((total / maxWeek) * 100).toFixed(1)}%`}>
                                  <i class="is-swim" style={`flex:${swim}`}></i>
                                  <i class="is-bike" style={`flex:${bike}`}></i>
                                  <i class="is-run" style={`flex:${run}`}></i>
                                </span>
                              );
                            })}
                          </div>
                          <div class="u-chart__labels">
                            {athlete.stats.weeks.map((_, weekIndex) => (
                              <span>S{weekIndex + 1}</span>
                            ))}
                          </div>
                          <div class="u-chart__legend">
                            <span><i class="is-swim"></i>Natación</span>
                            <span><i class="is-bike"></i>Bici</span>
                            <span><i class="is-run"></i>Carrera</span>
                          </div>
                          <p class="u-stats-note">Barras apiladas: la altura total es el volumen de la semana.</p>
                        </section>

                        <section class="u-app-panel u-stats-panel">
                          <div class="u-stats-panel__head">
                            <div>
                              <span class="u-mono">Detalle</span>
                              <h4>Por disciplina</h4>
                            </div>
                          </div>
                          <table class="u-table">
                            <thead>
                              <tr>
                                <th>Disciplina</th>
                                <th>Sesiones</th>
                                <th>Tiempo</th>
                                <th>Distancia</th>
                              </tr>
                            </thead>
                            <tbody>
                              {athlete.stats.disciplines.map((row) => (
                                <tr>
                                  <td><strong>{row.name}</strong></td>
                                  <td class="is-mono">{row.sessions}</td>
                                  <td class="is-mono">{row.time}</td>
                                  <td class="is-mono">{row.distance}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </section>
                      </div>

                      <section class="u-app-panel u-stats-panel u-consistency u-slide-anim">
                        <div class="u-stats-panel__head">
                          <div>
                            <span class="u-mono">Constancia</span>
                            <h4>Cómo de regular eres</h4>
                          </div>
                          <span class="u-mono">{activeWeeks} de 12 semanas activas</span>
                        </div>
                        <div class="u-heat" aria-hidden="true">
                          {heatWeeks.map((week) => (
                            <span class="u-heat__week">
                              {week.map((level) => (
                                <i class={`u-heat__cell u-heat__cell--${level}`}></i>
                              ))}
                            </span>
                          ))}
                        </div>
                        <div class="u-heat__footer">
                          <span class="u-mono">Cada columna es una semana; cada fila, un día.</span>
                          <span class="u-heat__legend" aria-hidden="true">
                            <span>Menos</span>
                            <i class="u-heat__cell u-heat__cell--1"></i>
                            <i class="u-heat__cell u-heat__cell--2"></i>
                            <i class="u-heat__cell u-heat__cell--3"></i>
                            <i class="u-heat__cell u-heat__cell--4"></i>
                            <span>Más</span>
                          </span>
                        </div>
                      </section>

                      <p class="u-fiche-slide__foot u-note">
                        Resumen de las últimas 12 semanas.
                      </p>
                    </>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <button class="u-fiche-arrow is-prev" type="button" data-fiche-prev aria-label="Pantalla anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 6-6 6 6 6" />
          </svg>
        </button>
        <button class="u-fiche-arrow is-next" type="button" data-fiche-next aria-label="Pantalla siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 6 6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="u-fiche__foot">
      <span class="u-note">Datos de ejemplo · pantallas de la app</span>
      <span class="u-note">Tests reales · zonas propias · carga estimada</span>
    </div>
  </div>
</section>

<style>
  .u-fiche-carousel { position: relative; }
  .u-fiche-stage { position: relative; }

  .u-fiche-viewport {
    overflow: hidden;
  }

  .u-fiche-track {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 18px;
  }

  .u-fiche-slide {
    flex: 0 0 82%;
    min-width: 0;
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }

  .u-fiche-slide.is-active { opacity: 1; }

  .u-fiche-slide__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 470px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--ivory);
  }

  @supports (corner-shape: squircle) {
    .u-fiche-slide__card,
    .u-app-panel { corner-shape: squircle; }
  }

  .u-app-panel {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
  }

  /* ===================== Perfil ===================== */

  .u-profile-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .u-profile-avatar {
    display: grid;
    width: 52px;
    height: 52px;
    flex: none;
    place-items: center;
    border-radius: 50%;
    color: var(--ink);
    background: var(--surface);
    font-family: var(--display);
    font-size: 13px;
    font-weight: 700;
  }

  .u-profile-who { min-width: 0; }

  .u-profile-eyebrow {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .u-profile-who h3 {
    margin-top: 2px;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.2vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .u-profile-meta {
    margin-top: 3px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
  }

  .u-profile-back {
    flex: none;
    margin-left: auto;
    cursor: default;
  }

  .u-profile-back:hover,
  .u-profile-back:active {
    border-color: var(--line);
    background: transparent;
    transform: none;
  }

  .u-profile-tests {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .u-test-block { padding: 13px 14px; }

  .u-test-block__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-soft);
  }

  .u-test-block__head h4 {
    color: var(--ink);
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .u-test-rows { display: grid; }

  .u-test-row {
    display: grid;
    grid-template-columns: 60px 62px 58px minmax(0, 1fr) 58px;
    align-items: center;
    gap: 8px;
    padding: 8px 2px;
    border-top: 1px solid var(--line-soft);
  }

  .u-test-row:first-child { border-top: 0; }

  .u-test-row.is-active {
    padding-inline: 8px;
    border-radius: 8px;
    background: var(--ivory);
  }

  .u-test-date,
  .u-test-value,
  .u-test-pace {
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 10px;
    white-space: nowrap;
  }


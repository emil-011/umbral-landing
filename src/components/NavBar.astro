---
import Logo from './Logo.astro';

const links = [
  { href: '#motor', label: 'El motor' },
  { href: '#producto', label: 'Producto' },
  { href: '#para-quien', label: 'Para quién' },
  { href: '#integraciones', label: 'Integraciones' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header class="site-nav" id="top">
  <div class="container nav__inner glass glass--blur">
    <Logo compact />

    <nav class="nav__links" aria-label="Navegación principal">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="nav__actions">
      <a class="btn btn-primary btn-sm nav__cta" href="#acceso">
        Pedir acceso
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <details class="nav__menu">
        <summary class="nav__toggle" aria-label="Abrir menú">
          <span></span>
          <span></span>
        </summary>
        <div class="nav__panel glass glass--blur">
          <nav aria-label="Navegación móvil">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <a class="btn btn-primary nav__panel-cta" href="#acceso">Pedir acceso</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 14px 0 auto;
    z-index: 100;
    pointer-events: none;
  }

  .nav__inner {
    --glass-strong: rgba(255, 255, 255, 0.83);
    --glass-soft: rgba(255, 255, 255, 0.55);
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    min-height: 68px;
    padding: 9px 10px 9px 22px;
    border-radius: 22px;
    box-shadow:
      inset 0 1px 0 #fff,
      0 14px 40px rgba(6, 55, 78, 0.12);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.1vw, 30px);
    margin-left: auto;
  }

  .nav__links a {
    position: relative;
    color: var(--ink-soft);
    font-size: 0.89rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms var(--ease);
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 -6px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease);
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav__menu {
    display: none;
    position: relative;
  }

  .nav__toggle {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    cursor: pointer;
    list-style: none;
  }

  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__toggle span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 220ms var(--ease);
  }

  .nav__menu[open] .nav__toggle span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .nav__menu[open] .nav__toggle span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .nav__panel {
    --glass-strong: rgba(255, 255, 255, 0.98);
    --glass-soft: rgba(255, 255, 255, 0.93);
    position: absolute;
    z-index: 20;
    top: calc(100% + 12px);
    right: 0;
    width: min(300px, calc(100vw - 32px));
    padding: 14px;
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 1px 0 #fff,
      0 24px 60px rgba(6, 55, 78, 0.24);
    animation: menu-in 180ms var(--ease) both;
  }

  .nav__panel nav {
    display: grid;
    gap: 2px;
  }

  .nav__panel nav a {
    padding: 11px 12px;
    border-radius: 10px;
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav__panel nav a:hover {
    background: rgba(255, 255, 255, 0.45);
  }

  .nav__panel-cta {
    width: 100%;
    margin-top: 10px;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 980px) {
    .nav__links {
      display: none;
    }

    .nav__menu {
      display: block;
    }

    .nav__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 620px) {
    .site-nav {
      top: 10px;
    }

    .nav__inner {
      min-height: 60px;
      padding: 7px 8px 7px 16px;
      border-radius: 18px;
    }

    .nav__cta {
      display: none;
    }
  }
</style>

---
import Logo from './Logo.astro';

const columns = [
  {
    title: 'Producto',
    links: [
      { label: 'El motor ECO', href: '#motor' },
      { label: 'Planificación', href: '#producto' },
      { label: 'Para entrenadores', href: '#para-quien' },
      { label: 'Integraciones', href: '#integraciones' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Cómo funciona', href: '#como-funciona' },
      { label: 'Preguntas', href: '#preguntas' },
      { label: 'Acceso anticipado', href: '#acceso' },
    ],
  },
];
---

<footer class="site-footer is-deep">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo />
      <p class="footer__tagline">La plataforma de entrenamiento para gente que sube cuestas.</p>
      <p class="footer__legacy">Sifos es la nueva identidad de tritrain.</p>
    </div>

    {columns.map((column) => (
      <nav class="footer__col" aria-label={column.title}>
        <h3>{column.title}</h3>
        <ul>
          {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    ))}

    <nav class="footer__col" aria-label="Legal">
      <h3>Legal</h3>
      <ul>
        <li>
          <a href="https://app.tritrain.es/privacidad" target="_blank" rel="noreferrer">Privacidad</a>
        </li>
        <li><a href="#top">Volver arriba</a></li>
      </ul>
    </nav>

    <span class="footer__watermark" aria-hidden="true">sifos.</span>
  </div>

  <div class="container footer__bottom">
    <span>© 2026 Sifos</span>
    <span class="footer__made">Entrenar es subir la cuesta. Medirla ayuda.</span>
    <span class="footer__loc">España · ES</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(56px, 7vw, 88px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 0.5fr));
    gap: clamp(28px, 4vw, 56px);
    padding-bottom: 54px;
  }

  .footer__brand {
    max-width: 340px;
  }

  .footer__brand :global(.brand) {
    margin-bottom: 16px;
  }

  .footer__tagline {
    color: var(--navy-soft);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .footer__legacy {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.36);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer__col h3 {
    margin-bottom: 16px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__col ul {
    display: grid;
    gap: 9px;
  }

  .footer__col a {
    color: var(--navy-soft);
    font-size: 0.84rem;
    text-decoration: none;
    transition: color 160ms var(--ease);
  }

  .footer__col a:hover {
    color: var(--ink);
  }

  .footer__watermark {
    position: absolute;
    right: -18px;
    bottom: -32px;
    z-index: -1;
    color: rgba(255, 255, 255, 0.035);
    font-family: var(--font-display);
    font-size: clamp(7rem, 18vw, 13rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 0.7;
    pointer-events: none;
    user-select: none;
  }

  .footer__inner {
    z-index: 1;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.46);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.04em;
  }

  .footer__made {
    color: rgba(255, 255, 255, 0.38);
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1.3fr 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
      max-width: 420px;
    }
  }

  @media (max-width: 600px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      padding-bottom: 38px;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
      padding-bottom: 26px;
    }

    .footer__made {
      display: none;
    }

    .footer__watermark {
      font-size: 7rem;
      bottom: -18px;
    }
  }
</style>

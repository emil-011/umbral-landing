---
import Logo from './Logo.astro';
import { APP_LOGIN_URL } from '../lib/app';

interface Props {
  /** En subpáginas, el prefijo para los enlaces por ancla de la home ('/'). */
  home?: string;
}

const { home = '' } = Astro.props;

const columns = [
  {
    title: 'Producto',
    links: [
      { label: 'El club', href: `${home}#club` },
      { label: 'La ficha', href: `${home}#ficha` },
      { label: 'El plan', href: `${home}#plan` },
      { label: 'Seguimiento', href: `${home}#seguimiento` },
      { label: 'Carga', href: `${home}#carga` },
      { label: 'Cómo funciona', href: `${home}#como` },
    ],
  },
  {
    title: 'Deportes',
    links: [
      { label: 'Triatlón', href: '/triatlon' },
      { label: 'Atletismo', href: '/atletismo' },
      { label: 'Natación', href: '/natacion' },
      { label: 'Ciclismo', href: '/ciclismo' },
      { label: 'Duatlón', href: '/duatlon' },
      { label: 'Acuatlón', href: '/acuatlon' },
    ],
  },
  {
    title: 'Guías',
    links: [
      { label: 'Zonas de entrenamiento', href: '/guias/zonas-de-entrenamiento' },
      { label: 'Carga de entrenamiento', href: '/guias/carga-de-entrenamiento' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Para clubes', href: '/para-clubes' },
      { label: 'Para entrenadores', href: '/para-entrenadores' },
      { label: 'Entrenadores y clubes', href: '/entrenamiento' },
      { label: 'Preguntas', href: `${home}#preguntas` },
      { label: 'Acceso anticipado', href: `${home}#acceso` },
      { label: 'Entrar en la app', href: APP_LOGIN_URL },
    ],
  },
];
---

<footer class="u-footer">
  <div class="u-wrap">
    <div class="u-footer__top">
      <div class="u-footer__brand">
        <Logo class="u-footer__logo" />
        <p class="u-footer__tagline">
          Entrena con tus marcas.<br />
          La app que empieza en tus tests, no en una fórmula.
        </p>
        <p class="u-footer__successor">
          <span class="u-dot" aria-hidden="true"></span>
          Servidores propios · España
        </p>
      </div>

      <div class="u-footer__columns">
        {columns.map((column) => (
          <div class="u-footer__column">
            <p class="u-mono">{column.title}</p>
            <ul>
              {column.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="u-footer__bottom">
      <p class="u-mono">© 2026 Umbral</p>
      <p class="u-mono">España · ES</p>
      <nav class="u-footer__legal" aria-label="Legal">
        <a href="/privacidad">Privacidad</a>
        <a href="/aviso-legal">Aviso legal</a>
      </nav>
      <a class="u-footer__up" href="#top">
        Volver arriba
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5M6 11l6-6 6 6" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .u-footer {
    padding-block: clamp(48px, 6vw, 76px) 28px;
    border-top: 1px solid var(--line);
    background: var(--ivory);
  }

  .u-footer__top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .u-footer__logo {
    font-size: 20px;
  }

  .u-footer__tagline {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.6;
  }

  .u-footer__successor {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .u-footer__columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(96px, 1fr));
    gap: clamp(20px, 2.6vw, 40px);
  }

  .u-footer__column .u-mono {
    color: var(--muted);
    font-size: 8px;
  }

  .u-footer__column ul {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }

  .u-footer__column a {
    color: var(--ink-soft);
    font-size: 13px;
    transition: color 160ms var(--ease);
  }

  .u-footer__column a:hover {
    color: var(--ink);
  }

  .u-footer__bottom {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .u-footer__bottom .u-mono {
    font-size: 7px;
  }

  .u-footer__legal {
    display: flex;
    gap: 14px;
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 7px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-footer__legal a {
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .u-footer__legal a:hover {
    color: var(--ink);
  }

  .u-footer__up {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-footer__up:hover {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .u-footer__top {
      flex-direction: column;
      gap: 32px;
    }

    .u-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .u-footer__bottom {
      flex-wrap: wrap;
    }
  }
</style>

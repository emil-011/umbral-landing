---
const frictions = [
  {
    icon: 'pencil',
    title: 'El método no cabe en un formulario',
    text: 'Cada entrenador escribe a su manera: abreviaturas, distancias, repeticiones. Las apps que obligan a bloques te cambian el método.',
  },
  {
    icon: 'watch',
    title: 'El reloj guarda, pero no explica',
    text: 'La sesión termina en el dispositivo y el plan se queda en una hoja aparte. Comparar lo hecho con lo previsto exige un tiempo que no tienes.',
  },
  {
    icon: 'bars',
    title: 'La carga se intuye',
    text: 'Sin una unidad común, comparar semanas, atletas o disciplinas es mirar números sin saber muy bien qué significan.',
  },
];
---

<section class="section problem" aria-labelledby="problem-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">El punto de partida</p>
      <h2 id="problem-title">
        El plan vive en un Excel. La sesión, en el reloj. La carga, en ningún sitio.
      </h2>
      <p class="lede">
        No falta esfuerzo. Falta que las piezas hablen el mismo idioma. Sifos nace para poner el
        plan, la sesión y la carga en la misma mesa.
      </p>
    </div>

    <div class="friction glass reveal">
      {frictions.map((item, index) => (
        <article class="friction__item">
          <div class="friction__top">
            <span class="friction__icon" aria-hidden="true">
              {item.icon === 'pencil' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                </svg>
              )}
              {item.icon === 'watch' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="6"></circle>
                  <path d="M9 3h6M9 21h6M12 9v3l2 1"></path>
                </svg>
              )}
              {item.icon === 'bars' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20V10M10 20V4M16 20v-7M22 20V7"></path>
                </svg>
              )}
            </span>
            <span class="friction__num">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .problem {
    padding-top: clamp(58px, 7vw, 98px);
  }

  .friction {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(38px, 4.5vw, 60px);
    overflow: hidden;
  }

  .friction__item {
    position: relative;
    padding: clamp(24px, 3vw, 36px);
  }

  .friction__item + .friction__item {
    border-left: 1px solid var(--hairline-soft);
  }

  .friction__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .friction__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 13px;
    color: var(--accent-deep);
    background: rgba(255, 255, 255, 0.44);
    box-shadow: inset 0 1px 0 #fff;
  }

  .friction__num {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
  }

  .friction h3 {
    max-width: 15ch;
    margin-top: 24px;
    font-size: clamp(1.32rem, 1.8vw, 1.55rem);
    line-height: 1.06;
  }

  .friction p {
    max-width: 34ch;
    margin-top: 12px;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .friction {
      grid-template-columns: 1fr;
    }

    .friction__item + .friction__item {
      border-top: 1px solid var(--hairline-soft);
      border-left: 0;
    }

    .friction h3,
    .friction p {
      max-width: 52ch;
    }

    .friction h3 {
      margin-top: 18px;
    }
  }
</style>

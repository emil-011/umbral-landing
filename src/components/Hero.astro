---
import DiscIcon from './DiscIcon.astro';
import Wordmark from './Wordmark.astro';

const days = [
  {
    weekday: 'LUN',
    day: '16',
    steps: [
      {
        disc: 'SWIM',
        label: 'Natación',
        value: '600m Z1 + 8x100m Z3',
        rpe: null,
      },
    ],
    eco: 42,
    ecs: null,
  },
  {
    weekday: 'MAR',
    day: '17',
    steps: [
      {
        disc: 'BIKE',
        label: 'Ciclismo',
        value: "15' Z1 + 3x12' Z4",
        rpe: null,
      },
      { disc: 'RUN', label: 'Carrera', value: "40' Z2", rpe: 7 },
    ],
    eco: 124,
    ecs: 7,
  },
  {
    weekday: 'MIÉ',
    day: '18',
    steps: [
      {
        disc: 'SWIM',
        label: 'Natación',
        value: '400m Z1 + 8x100m Z4 / 20"',
        rpe: null,
      },
    ],
    eco: 46,
    ecs: null,
  },
  {
    weekday: 'JUE',
    day: '19',
    steps: [
      {
        disc: 'RUN',
        label: 'Carrera',
        value: '3 km Z1 + 8x1km Z4',
        rpe: 5,
      },
    ],
    eco: 38,
    ecs: 5,
  },
  {
    weekday: 'VIE',
    day: '20',
    steps: [
      {
        disc: 'BIKE',
        label: 'Ciclismo',
        value: "15' Z1 + 2x20' Z3",
        rpe: null,
      },
    ],
    eco: 51,
    ecs: null,
  },
  {
    weekday: 'SÁB',
    day: '21',
    steps: [
      {
        disc: 'RUN',
        label: 'Carrera',
        value: "20' Z1 + 60' Z2 + 10' Z1",
        rpe: 6,
      },
    ],
    eco: 45,
    ecs: 6,
  },
  { weekday: 'DOM', day: '22', steps: [], eco: null, ecs: null },
] as const;

/* Convierte "400 m Z1 + 6 × 100 m Z3" en texto y pastillas de zona, igual que
   el editor de planes de la app. Las zonas siguen siendo las de por defecto. */
const parseValue = (value: string) =>
  value.split(/(Z[1-5])/g).flatMap((part) => {
    if (!part) return [];
    if (/^Z[1-5]$/.test(part)) {
      return [{ text: '', zone: part, level: part.toLowerCase() }];
    }
    const text = part.trim();
    return text ? [{ text, zone: null, level: null }] : [];
  });

/* El dial del hero: las cinco zonas giran alrededor del ritmo umbral. */
const gaugeZones = [
  { level: 'z1', rotate: -90 },
  { level: 'z2', rotate: -18 },
  { level: 'z3', rotate: 54 },
  { level: 'z4', rotate: 126 },
  { level: 'z5', rotate: 198 },
];

const chips = [
  { label: 'ECOs', value: 346, note: 'carga semanal', pos: '1', decimals: 0 },
  { label: 'TSS', value: 412, note: 'estimado', pos: '2', decimals: 0 },
  { label: 'FC máx.', value: 172, note: 'ppm', pos: '3', decimals: 0 },
  { label: 'RPE', value: 7, note: 'sesión', pos: '4', decimals: 0 },
];

const ticker = [
  'Natación',
  'Bici',
  'Carrera',
  'Tests',
  'Ritmos',
  'Zonas',
  'Plan en texto libre',
  'ECO',
  'ECS',
  'TSS',
  'CTL',
  'ATL',
  'TSB',
];
---

<section class="u-hero" aria-labelledby="u-hero-title">
  <div class="u-hero__stage">
    <div class="u-hero__grid-lines" aria-hidden="true"></div>
    <div class="u-hero__glow" aria-hidden="true"></div>

    <div class="u-wrap u-hero__grid">
      <div class="u-hero__copy">
        <p class="u-kicker" data-reveal>App de entrenamiento · clubes, entrenadores y atletas</p>

        <h1 class="u-hero__title" id="u-hero-title" data-hero-title>
          <span class="u-hero__line">Todo tu club</span>{' '}
          <span class="u-hero__line u-hero__line--soft">
            en su <em><span class="visually-hidden">umbral</span><Wordmark class="u-hero__wordmark" /><span class="u-hero__period">.</span></em>
          </span>
        </h1>

        <p class="u-hero__lead" data-reveal>
          Umbral es la app de entrenamiento de triatlón, atletismo, natación y ciclismo. Los tests
          de cada atleta fijan sus ritmos, el plan se escribe como siempre y lo que de verdad ha
          hecho aparece al lado. Todo en un solo sitio.
        </p>

        <div class="u-hero__actions" data-reveal>
          <a class="u-btn" href="#acceso">
            <span class="u-dot" aria-hidden="true"></span>
            Pedir acceso para mi club
          </a>
          <a class="u-btn u-btn--dark-ghost" href="#ficha">
            Ver la ficha de un atleta
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        <ul class="u-hero__proof" data-reveal>
          <li>Tests por atleta</li>
          <li>Plan en texto libre</li>
          <li>Garmin · Polar · Wahoo</li>
        </ul>
      </div>

      <div class="u-hero__visual">
        <div class="u-hero__gauge-wrap" data-hero-gauge>
          <svg class="u-hero__gauge" viewBox="0 0 560 560" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="u-hero-core-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#20d458" stop-opacity="0.34" />
                <stop offset="55%" stop-color="#20d458" stop-opacity="0.07" />
                <stop offset="100%" stop-color="#20d458" stop-opacity="0" />
              </radialGradient>
            </defs>

            <circle class="u-hero__core-halo" cx="280" cy="280" r="122" fill="url(#u-hero-core-glow)" data-hero-core />

            <circle class="u-hero__ring is-ticks" cx="280" cy="280" r="262" pathLength="100" />
            <circle class="u-hero__ring is-outer" cx="280" cy="280" r="248" />
            <circle class="u-hero__ring is-inner" cx="280" cy="280" r="132" />
            <circle class="u-hero__ring is-core" cx="280" cy="280" r="104" />

            <g class="u-hero__zones" data-hero-zones>
              {gaugeZones.map((zone) => (
                <circle
                  class={`u-hero__zone-arc is-${zone.level}`}
                  cx="280"
                  cy="280"
                  r="232"
                  pathLength="100"
                  stroke-dasharray="14 86"
                  transform={`rotate(${zone.rotate} 280 280)`}
                />
              ))}
            </g>

            <g class="u-hero__arc is-swim" data-hero-arc="swim">
              <circle
                cx="280"
                cy="280"
                r="196"
                pathLength="100"
                stroke-dasharray="23 77"
                stroke-dashoffset="0"
              />
            </g>
            <g class="u-hero__arc is-bike" data-hero-arc="bike">
              <circle
                cx="280"
                cy="280"
                r="176"
                pathLength="100"
                stroke-dasharray="19 81"
                stroke-dashoffset="-36"
              />
            </g>
            <g class="u-hero__arc is-run" data-hero-arc="run">
              <circle
                cx="280"
                cy="280"
                r="156"
                pathLength="100"
                stroke-dasharray="15 85"
                stroke-dashoffset="-70"
              />
            </g>

            <text class="u-hero__zone-tag" x="280" y="214" text-anchor="middle">Z4</text>
            <text class="u-hero__pace" x="280" y="270" text-anchor="middle">4:12</text>
            <text class="u-hero__pace-unit" x="280" y="294" text-anchor="middle">/km</text>
            <text class="u-hero__pace-label" x="280" y="322" text-anchor="middle">RITMO UMBRAL</text>
          </svg>

          <div class="u-hero__chips" aria-hidden="true">
            {chips.map((chip) => (
              <span class={`u-hero__chip is-${chip.pos}`} data-hero-chip>
                <small>{chip.label}</small>
                <b data-count={chip.value} data-decimals={chip.decimals}>{chip.value}</b>
                <i>{chip.note}</i>
              </span>
            ))}
          </div>
        </div>

        <div class="u-hero__discs" aria-hidden="true">
          <span class="is-swim"><DiscIcon disc="SWIM" />Natación</span>
          <span class="is-bike"><DiscIcon disc="BIKE" />Bici</span>
          <span class="is-run"><DiscIcon disc="RUN" />Carrera</span>
        </div>
      </div>
    </div>

    <div class="u-hero__ticker" aria-hidden="true">
      <div class="u-hero__ticker-track">
        {[0, 1].map(() => (
          <span class="u-hero__ticker-row">
            {ticker.map((word) => <i>{word}</i>)}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="u-weekhome u-section u-section--tight" aria-labelledby="u-week-title">
  <div class="u-wrap">
    <header class="u-head u-weekhome__head" data-reveal>
      <div>
        <p class="u-kicker">La semana, de un vistazo</p>
        <h2 class="u-title u-title--md" id="u-week-title">
          El plan,<br /><span class="soft">día a día.</span>
        </h2>
      </div>

      <div class="u-weekhome__aside">
        <p class="u-head__note">
          La sesión escrita como siempre, con sus zonas y su carga. El atleta ve qué toca; el
          entrenador, cómo va la semana.
        </p>
        <p class="u-note">Datos de ejemplo · semana 12</p>
        <a class="u-link" href="#plan">
          Ver el plan completo
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </header>

    <div class="u-week" data-reveal>
      <div class="u-week__bar">
        <span class="u-week__meta"><strong>Panel</strong> / semana en curso</span>
        <span class="u-week__group">
          Grupo Élite
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </div>

      <div class="u-week__head">
        <div class="u-week__heading">
          <h3>Esta semana</h3>
          <p class="u-week__date">Semana 12 · 16–22 jun</p>
        </div>

        <div class="u-week__tools">
          <div class="u-week__totals">
            <span class="u-week__total">
              <small>ECOs</small>
              <b data-count="346">346</b>
            </span>
            <span class="u-week__total">
              <small>ECSs</small>
              <b data-count="6" data-decimals="1">6,0</b>
            </span>
          </div>
          <span class="u-week__paces"><i class="u-dot u-dot--pulse" aria-hidden="true"></i>Ritmos</span>
        </div>
      </div>

      <div class="u-week__body">
        {days.map((row, index) => (
          <div class:list={['u-week__row', index === 0 && 'u-week__row--today']}>
            <span class="u-week__day">
              <small>{row.weekday}</small>
              <b>{row.day}</b>
            </span>

            <span class="u-week__steps">
              {row.steps.length === 0 ? (
                <span class="u-week__rest">Descanso</span>
              ) : (
                row.steps.map((step) => (
                  <span class={`u-week__step u-week__step--${step.disc.toLowerCase()}`}>
                    <span class="u-week__step-head">
                      <span class={`u-disc u-disc--${step.disc.toLowerCase()}`}>
                        <DiscIcon disc={step.disc} />
                        {step.label}
                      </span>
                      {step.rpe !== null && (
                        <span class="u-rpe">RPE <b>{step.rpe}</b></span>
                      )}
                    </span>
                    <span class="u-week__step-value">
                      {parseValue(step.value).map((part) =>
                        part.zone ? (
                          <span class={`u-week__zone u-week__zone--${part.level}`}>{part.zone}</span>
                        ) : (
                          <span class="u-week__val">{part.text}</span>
                        ),
                      )}
                    </span>
                  </span>
                ))
              )}
            </span>

            <span class="u-week__loads">
              {row.eco !== null && (
                <span class="u-week__load">
                  <small>ECOs</small>
                  <b>{row.eco}</b>
                </span>
              )}
              {row.ecs !== null && (
                <span class="u-week__load u-week__load--ecs">
                  <small>ECSs</small>
                  <b>{row.ecs}</b>
                </span>
              )}
            </span>
          </div>
        ))}

        <div class="u-week__summary">
          <span class="u-mono">La semana</span>
          <p>Seis sesiones planificadas y un domingo de descanso. La carga más alta cae el martes.</p>
        </div>
      </div>

      <div class="u-week__foot">
        <span class="u-mono">Datos de ejemplo · semana 12</span>
        <span class="u-mono">Natación · Bici · Carrera</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ===================== Escenario del hero ===================== */

  .u-hero {
    position: relative;
    padding: 12px 0 0;
  }

  .u-hero__stage {
    position: relative;
    display: flex;
    align-items: center;
    width: min(100% - 24px, calc(var(--u-max) + 80px));
    min-height: calc(100vh - 90px);
    min-height: calc(100svh - 90px);
    margin-inline: auto;
    padding-block: clamp(46px, 5vw, 78px) clamp(96px, 8vw, 128px);
    overflow: hidden;
    border-radius: clamp(30px, 4.6vw, 64px);
    color: var(--ivory);
    background: var(--ink);
  }

  .u-hero__grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(240, 237, 229, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(240, 237, 229, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(120% 110% at 72% 38%, #000 24%, transparent 78%);
    -webkit-mask-image: radial-gradient(120% 110% at 72% 38%, #000 24%, transparent 78%);
    pointer-events: none;
  }

  .u-hero__glow {
    position: absolute;
    top: -12%;
    right: -6%;
    width: 64%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(32, 212, 88, 0.18), rgba(32, 212, 88, 0) 66%);
    filter: blur(8px);
    pointer-events: none;
  }

  .u-hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    align-items: center;
    gap: clamp(24px, 4vw, 58px);
  }

  .u-hero__copy {
    min-width: 0;
  }

  .u-hero__title {
    margin-top: 26px;
    color: var(--ivory);
    font-family: var(--display);
    font-size: clamp(3.1rem, 6.5vw, 7.3rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .u-hero__line {
    display: block;
  }

  .u-hero__line--soft {
    color: #8a8981;
  }

  .u-hero__title em {
    color: var(--signal);
    font-style: normal;
  }

  :global(.u-hero__wordmark) {
    display: inline-block;
    width: auto;
    height: 0.68em;
    margin-inline: 0.03em 0.01em;
    vertical-align: -0.02em;
    color: var(--signal);
  }

  .u-hero__period {
    color: var(--ivory);
  }

  .u-hero .u-kicker {
    color: var(--stone);
    font-size: 11px;
    letter-spacing: 0.13em;
  }

  .u-hero__lead {
    max-width: 46ch;
    margin-top: 28px;
    color: #cbc8bf;
    font-size: clamp(1.08rem, 1.3vw, 1.34rem);
    line-height: 1.62;
  }

  .u-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .u-hero__actions .u-btn {
    min-height: 54px;
    padding-inline: 26px;
    border-color: var(--signal);
    color: var(--ink);
    background: var(--signal);
    font-size: 14px;
  }

  .u-hero__actions .u-btn:hover {
    border-color: #38ea6c;
    background: #38ea6c;
  }

  .u-hero__actions .u-btn .u-dot {
    background: var(--ink);
  }

  .u-hero__actions .u-btn--dark-ghost {
    border-color: rgba(240, 237, 229, 0.22);
    color: var(--ivory);
    background: transparent;
  }

  .u-hero__actions .u-btn--dark-ghost:hover {
    border-color: rgba(240, 237, 229, 0.5);
    background: transparent;
  }

  .u-hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 32px;
    color: #8d8c84;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .u-hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .u-hero__proof li::before {
    content: '';
    width: 5px;
    height: 5px;
    border: 1px solid #7f7e76;
    border-radius: 50%;
  }

  /* ===================== Instrumento de umbral ===================== */

  .u-hero__visual {
    position: relative;
    min-width: 0;
  }

  .u-hero__gauge-wrap {
    position: relative;
    width: min(100%, 560px);
    margin-inline: auto;
    aspect-ratio: 1;
  }

  .u-hero__gauge {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .u-hero__ring {
    fill: none;
    stroke: var(--ivory);
  }

  .u-hero__ring.is-ticks {
    stroke-opacity: 0.32;
    stroke-width: 6;
    stroke-dasharray: 0.35 1.65;
    stroke-linecap: round;
  }

  .u-hero__ring.is-outer {
    stroke-opacity: 0.12;
    stroke-width: 1;
  }

  .u-hero__ring.is-inner {
    stroke-opacity: 0.08;
    stroke-width: 1;
    stroke-dasharray: 2 7;
  }

  .u-hero__ring.is-core {
    stroke-opacity: 0.13;
    stroke-width: 1;
  }

  .u-hero__zone-arc {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0.82;
  }

  .u-hero__zone-arc.is-z1 { stroke: var(--z1); }
  .u-hero__zone-arc.is-z2 { stroke: var(--z2); }
  .u-hero__zone-arc.is-z3 { stroke: var(--z3); }
  .u-hero__zone-arc.is-z4 { stroke: var(--z4); }
  .u-hero__zone-arc.is-z5 { stroke: var(--z5); }

  .u-hero__arc circle {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .u-hero__arc.is-swim circle { stroke: #37a9cd; }
  .u-hero__arc.is-bike circle { stroke: #5cba55; }
  .u-hero__arc.is-run circle { stroke: #e0654d; }

  .u-hero__zone-tag {
    fill: var(--signal);
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .u-hero__pace {
    fill: var(--ivory);
    font-family: var(--display);
    font-size: 58px;
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .u-hero__pace-unit {
    fill: #cfccc3;
    font-family: var(--mono);
    font-size: 16px;
    letter-spacing: 0.12em;
  }

  .u-hero__pace-label {
    fill: #b9b6ad;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .u-hero__chips {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .u-hero__chip {
    position: absolute;
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 2px 9px;
    padding: 10px 13px;
    border: 1px solid rgba(240, 237, 229, 0.14);
    border-radius: 14px;
    background: rgba(26, 27, 24, 0.82);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .u-hero__chip small {
    grid-column: 1 / -1;
    color: #8d8c84;
    font-family: var(--mono);
    font-size: 7px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .u-hero__chip b {
    color: var(--ivory);
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .u-hero__chip i {
    color: #8d8c84;
    font-family: var(--sans);
    font-size: 8.5px;
    font-style: normal;
  }

  .u-hero__chip.is-1 {
    top: 7%;
    left: -3%;
  }

  .u-hero__chip.is-2 {
    top: 18%;
    right: -4%;
  }

  .u-hero__chip.is-3 {
    bottom: 15%;
    left: -5%;
  }

  .u-hero__chip.is-4 {
    right: 1%;
    bottom: 4%;
  }

  .u-hero__discs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 18px auto 0;
  }

  .u-hero__discs span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 7px 10px;
    border: 1px solid rgba(240, 237, 229, 0.14);
    border-radius: 999px;
    color: #cbc8bf;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
  }

  :global(.u-hero__discs span svg) {
    width: 16px;
    height: 16px;
    color: var(--dc);
  }

  .u-hero__discs .is-swim { --dc: #37a9cd; }
  .u-hero__discs .is-bike { --dc: #5cba55; }

---
interface Props {
  href?: string;
  compact?: boolean;
  wordmark?: boolean;
  class?: string;
}

const { href = '#top', compact = false, wordmark = true, class: className = '' } = Astro.props;
---

<a class:list={['brand', className]} href={href} aria-label="Sifos, ir al inicio">
  <svg
    class="brand__mark"
    viewBox="0 0 64 64"
    fill="none"
    stroke="currentColor"
    stroke-width="4.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M6 55 58 27"></path>
    <circle cx="36" cy="25" r="13.6" fill="currentColor" stroke="none"></circle>
    <path d="M10 61 28 52"></path>
    <path d="M36 49 57 38"></path>
  </svg>
  {wordmark && <span class:list={['brand__word', { 'brand__word--compact': compact }]}>sifos<span class="brand__dot">.</span></span>}
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }

  .brand__mark {
    width: 31px;
    height: 31px;
    flex: none;
    overflow: visible;
  }

  .brand__word {
    font-family: var(--font-display);
    font-size: 1.48rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    transform: translateY(-1px);
  }

  .brand__word--compact {
    font-size: 1.28rem;
  }

  .brand__dot {
    color: var(--accent-deep);
  }

  :global(.is-deep) .brand__dot {
    color: var(--accent-light);
  }
</style>
